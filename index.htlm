          <div class="frow3"><div class="fg"><label class="flabel">Mês de referência</label><input id="relMes" class="finput" type="month"></div><div class="fg"><label class="flabel">Turma SIGOP</label><select id="relSigop" class="finput"><option value="">Todas</option></select></div><div class="fg"><label class="flabel">Turno</label><select id="relTurno" class="finput"><option value="">Todos</option><option>Matutino</option><option>Vespertino</option><option>Noturno</option></select></div></div>
          <div class="frow"><div class="fg"><label class="flabel">Empresa</label><input id="relEmpresa" class="finput" placeholder="Filtrar por empresa"></div><div class="fg"><label class="flabel">Status contratual</label><select id="relStatus" class="finput"><option value="">Todos</option><option>Em execução</option><option>Concluído</option><option>Cancelado</option><option>Desistente</option></select></div></div>
          <div style="display:flex;gap:10px;flex-wrap:wrap"><button class="btn btn-primary" onclick="renderRelatorio()">Gerar relatório</button><button class="btn btn-outline" onclick="exportPDF()">Exportar PDF</button><button class="btn btn-outline" onclick="exportXLSX()">Exportar XLSX</button><button class="btn btn-danger btn-sm" onclick="limparDados()" style="margin-left:auto">Limpar dados</button></div>
        </div></div>
        <div class="card"><div class="card-header"><div class="card-title" id="relTitulo">Relatório Mensal</div><div class="card-sub" id="relSub"></div></div><div class="tw"><table id="relTabela"><thead id="relHead"></thead><tbody id="relBody"></tbody></table></div><div id="relEmpty" class="hidden" style="text-align:center;padding:40px;color:var(--text3)">Nenhum dado.</div></div>
      </div>
    </div>
  </div>
</div>

