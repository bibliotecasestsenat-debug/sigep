      <div class="fg"><label class="flabel">Motivos <span class="req">*</span></label>
        <div id="advMotivos" style="border:1px solid var(--border);border-radius:var(--r-sm);padding:4px 14px">
          <label class="motivo-check"><input type="checkbox" value="Faltas frequentes sem justificativa"> Faltas frequentes sem justificativa</label>
          <label class="motivo-check"><input type="checkbox" value="Atrasos constantes"> Atrasos constantes</label>
          <label class="motivo-check"><input type="checkbox" value="Desrespeito a instrutores, funcionários ou colegas"> Desrespeito a instrutores, funcionários ou colegas</label>
          <label class="motivo-check"><input type="checkbox" value="Não realização das atividades propostas"> Não realização das atividades propostas</label>
          <label class="motivo-check"><input type="checkbox" value="Danos ao patrimônio da instituição"> Danos ao patrimônio da instituição</label>
          <label class="motivo-check"><input type="checkbox" value="Uso inadequado de tecnologia durante as aulas"> Uso inadequado de tecnologia durante as aulas</label>
          <label class="motivo-check"><input type="checkbox" value="Comportamento inadequado no ambiente escolar"> Comportamento inadequado no ambiente escolar</label>
          <label class="motivo-check"><input type="checkbox" value="Descumprimento das regras de conduta da instituição"> Descumprimento das regras de conduta da instituição</label>
        </div>
      </div>
      <div class="fg"><label class="flabel">OBS</label><textarea id="advObs" class="finput" placeholder="Observações complementares..."></textarea></div>
      <div id="advAlertaSusp" class="hidden alert al-danger">Esta será a <strong>3ª advertência</strong>. O aluno ficará elegível para suspensão.</div>
    </div>
    <div class="mf"><button class="btn btn-outline" onclick="closeMov('mov-advertencia')">Cancelar</button><button class="btn btn-warn" onclick="confirmarAdvertencia()">Emitir advertência</button></div>
