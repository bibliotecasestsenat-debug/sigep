        <div class="card"><div class="card-header"><div class="card-title">Histórico disciplinar consolidado</div></div><div class="tw"><table><thead><tr><th>Aluno</th><th>Turma</th><th>Empresa</th><th>Status</th><th>Adv.</th><th>Susp.</th><th>Situação</th></tr></thead><tbody id="tbHistorico"></tbody></table></div></div>
