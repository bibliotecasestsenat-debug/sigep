<div class="toast-wrap" id="toastWrap"></div>

<script>
const LOGO_JA = 'data:image/png;base64,';
const LOGO_AZUL = 'data:image/png;base64,';
const LOGO_SIST = 'data:image/png;base64,';

const SK={usuarios:'sigep3_u',turmas:'sigep3_t',alunos:'sigep3_a',frequencias:'sigep3_f',advertencias:'sigep3_adv',suspensoes:'sigep3_s',notificacoes:'sigep3_notif'};

/* ── DADOS INICIAIS ── */
const U0=[
  {id:1,nome:'Prof. Carlos',email:'carlos@sestsenat.org.br',perfil:'prof_efetivo',senha:'123'},
  {id:2,nome:'Coordenação Geral',email:'coordenacao@sestsenat.org.br',perfil:'coordenacao',senha:'123'},
  {id:3,nome:'Administrador',email:'adm@sest.com',perfil:'adm',senha:'123'},
];
const T0=[
  {id:1,codigoSigop:'620279',codigoInterno:'JM59',curso:'ADM CRJ',turno:'Matutino',diasSemana:'Seg, Qua, Sex',status:'Ativa',instrutorId:1},
  {id:2,codigoSigop:'620300',codigoInterno:'JV12',curso:'LOG SALA 04',turno:'Vespertino',diasSemana:'Ter, Qui',status:'Ativa',instrutorId:1},
];
const A0=[
  {id:1,nome:'Lucas Martins',cpf:'111.111.111-11',matricula:'2026001',curso:'ADM CRJ',turmaId:1,turmaSigop:'620279',turma:'JM59',turno:'Matutino',diasSemana:'Seg, Qua, Sex',contratoInicio:'2026-01-10',contratoFim:'2026-12-10',status:'Em execução',empresa:'Swissport',cnpj:'12.345.678/0001-00',advertencias:2},
  {id:2,nome:'Maria Eduarda',cpf:'222.222.222-22',matricula:'2026002',curso:'ADM CRJ',turmaId:1,turmaSigop:'620279',turma:'JM59',turno:'Matutino',diasSemana:'Seg, Qua, Sex',contratoInicio:'2026-02-01',contratoFim:'2026-11-30',status:'Em execução',empresa:'Vale',cnpj:'98.765.432/0001-10',advertencias:0},
  {id:3,nome:'Pedro Henrique',cpf:'333.333.333-33',matricula:'2026003',curso:'LOG SALA 04',turmaId:2,turmaSigop:'620300',turma:'JV12',turno:'Vespertino',diasSemana:'Ter, Qui',contratoInicio:'2026-01-20',contratoFim:'2026-10-20',status:'Em execução',empresa:'Magalu',cnpj:'55.555.555/0001-55',advertencias:3},
  {id:4,nome:'Carla Beatriz',cpf:'444.444.444-44',matricula:'2026004',curso:'ADM CRJ',turmaId:1,turmaSigop:'620279',turma:'JM59',turno:'Matutino',diasSemana:'Seg, Qua, Sex',contratoInicio:'2026-02-10',contratoFim:'2026-12-10',status:'Em execução',empresa:'Petrobras',cnpj:'33.000.167/0001-01',advertencias:0},
];
const F0=[
  {id:1,alunoId:1,turmaSigop:'620279',data:'2026-03-02',status:'F',justificativa:'',validada:false},
  {id:2,alunoId:1,turmaSigop:'620279',data:'2026-03-05',status:'F',justificativa:'',validada:false},
  {id:3,alunoId:1,turmaSigop:'620279',data:'2026-03-09',status:'P',justificativa:'',validada:true},
  {id:4,alunoId:2,turmaSigop:'620279',data:'2026-03-05',status:'J',justificativa:'Atestado médico',validada:true},
  {id:5,alunoId:2,turmaSigop:'620279',data:'2026-03-09',status:'P',justificativa:'',validada:true},
  {id:6,alunoId:3,turmaSigop:'620300',data:'2026-03-04',status:'F',justificativa:'',validada:false},
  {id:7,alunoId:3,turmaSigop:'620300',data:'2026-03-11',status:'F',justificativa:'',validada:false},
  {id:8,alunoId:4,turmaSigop:'620279',data:'2026-03-02',status:'P',justificativa:'',validada:true},
  {id:9,alunoId:4,turmaSigop:'620279',data:'2026-03-05',status:'P',justificativa:'',validada:true},
];
const ADV0=[{id:1,alunoId:1,turmaSigop:'620279',datasFalta:['2026-03-02','2026-03-05'],motivos:['Faltas frequentes sem justificativa'],observacao:'',status:'Pendente',dataEmissao:''}];
const SUP0=[{id:1,alunoId:3,turmaSigop:'620300',motivo:'falta_grave',motivoTexto:'( ) Falta disciplinar grave',obs:'Reincidência disciplinar comprovada.',periodo:['2026-03-26','2026-03-27','2026-03-28'],status:'Emitida'}];

let usuarios,turmas,alunos,frequencias,advertencias,suspensoes,usuarioAtual=null;
let advAtualId=null,suspAlunoId=null,docAdvId=null,docSuspId=null,confirmCb=null,lancs={};

function ls(k,fb){try{const v=localStorage.getItem(k);return v?JSON.parse(v):fb;}catch{return fb;}}
function sv(k,d){try{localStorage.setItem(k,JSON.stringify(d));}catch{}}
function svAll(){sv(SK.usuarios,usuarios);sv(SK.turmas,turmas);sv(SK.alunos,alunos);sv(SK.frequencias,frequencias);sv(SK.advertencias,advertencias);sv(SK.suspensoes,suspensoes);}
function uid(){return Date.now()+Math.floor(Math.random()*1e6);}
function hj(){const d=new Date(),off=d.getTimezoneOffset()*60000;return new Date(d.getTime()-off).toISOString().slice(0,10);}
function fd(d){if(!d)return'—';const[y,m,dd]=d.split('-');return `${dd}/${m}/${y}`;}
function fdLong(d){if(!d)return'—';const months=['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];const[y,m,dd]=d.split('-');return `${parseInt(dd)} de ${months[parseInt(m)-1]} de ${y}`;}
function maskCpf(el){let v=el.value.replace(/\D/g,'');v=v.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})\.(\d{3})(\d)/,'$1.$2.$3').replace(/(\d{3})\.(\d{3})\.(\d{3})(\d)/,'$1.$2.$3-$4');el.value=v.slice(0,14);}
function ini(n){return(n||'?').split(' ').filter(Boolean).slice(0,2).map(w=>w[0].toUpperCase()).join('');}
function lpf(p){return{professor:'Professor/Instrutor',prof_efetivo:'Professor Efetivo',prof_cnpj:'Professor CNPJ',adm:'ADM (Administrador)',coordenacao:'Coordenação'}[p]||p;}
function pode(...ps){return ps.flat().includes(usuarioAtual?.perfil);}
function ehProfessor(){return pode(['professor','prof_efetivo','prof_cnpj']);}
function ehProfCNPJ(){return pode(['professor','prof_cnpj']);}  // restrito às próprias turmas
function ehProfEfetivo(){return pode(['prof_efetivo']);}       // acessa todas as turmas
function podeAdm(){return pode(['adm','coordenacao']);}
function podeCoord(){return podeAdm();}
function podeEmitir(){return pode(['adm','coordenacao','professor','prof_efetivo','prof_cnpj']);}
function podeUser(){return podeAdm();}
function sb(s){const m={'Em execução':'b-green','Cancelado':'b-red','Concluído':'b-blue','Desistente':'b-gray','Pendente':'b-amber','Emitida':'b-green','Ativa':'b-green','Encerrada':'b-gray','Concluída':'b-blue'};return `<span class="badge ${m[s]||'b-gray'}">${s}</span>`;}
function diasPT(){return['Dom','Seg','Ter','Qua','Qui','Sex','Sab'][new Date().getDay()];}

/* ── AUTH ── */
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.modal-ov').forEach(ov=>ov.addEventListener('click',e=>{if(e.target===ov)ov.classList.remove('open')}));
  usuarios=ls(SK.usuarios,U0);
});

function doLogin(){
  usuarios=ls(SK.usuarios,U0);
  const email=document.getElementById('lEmail').value.trim().toLowerCase();
  const senha=document.getElementById('lSenha').value;
  const u=usuarios.find(x=>x.email.toLowerCase()===email);
  const err=document.getElementById('loginErr');
  if(!u||u.senha!==senha){err.textContent='E-mail ou senha incorretos.';err.classList.remove('hidden');return;}
  err.classList.add('hidden');
  usuarioAtual=u;
  initApp();
}

function abrirMinhaConta(){
  document.getElementById('mcNome').value=usuarioAtual.nome;
  document.getElementById('mcEmail').value=usuarioAtual.email;
  document.getElementById('mcSenhaAtual').value='';
  document.getElementById('mcNovaSenha').value='';
  document.getElementById('mcConfSenha').value='';
  openMov('mov-minhaConta');
}

function salvarMinhaConta(){
  const nome=document.getElementById('mcNome').value.trim();
  const email=document.getElementById('mcEmail').value.trim();
  const senhaAtual=document.getElementById('mcSenhaAtual').value;
  const novaSenha=document.getElementById('mcNovaSenha').value;
  const confSenha=document.getElementById('mcConfSenha').value;
  if(!nome||!email){toast('Preencha nome e e-mail.','error');return;}
  if(senhaAtual||novaSenha||confSenha){
    if(senhaAtual!==usuarioAtual.senha){toast('Senha atual incorreta.','error');return;}
    if(novaSenha.length<3){toast('Nova senha muito curta (mín. 3 caracteres).','error');return;}
    if(novaSenha!==confSenha){toast('Confirmação de senha não confere.','error');return;}
    usuarioAtual.senha=novaSenha;
  }
  if(usuarios.some(u=>u.email.toLowerCase()===email.toLowerCase()&&u.id!==usuarioAtual.id)){toast('E-mail já em uso por outro usuário.','error');return;}
  usuarioAtual.nome=nome;usuarioAtual.email=email;
  const idx=usuarios.findIndex(u=>u.id===usuarioAtual.id);
  if(idx>=0)usuarios[idx]={...usuarioAtual};
  sv(SK.usuarios,usuarios);
  document.getElementById('sbName').textContent=usuarioAtual.nome;
  closeMov('mov-minhaConta');
  toast('Dados atualizados com sucesso!','success');
  renderUsuarios();
}

function doLogout(){
  usuarioAtual=null;
  document.getElementById('appScreen').classList.add('hidden');
  document.getElementById('loginScreen').classList.remove('hidden');
  document.getElementById('lSenha').value='';
  document.getElementById('lEmail').value='';
}

/* ── INIT APP ── */
function initApp(){
  turmas=ls(SK.turmas,T0);alunos=ls(SK.alunos,A0);frequencias=ls(SK.frequencias,F0);
  advertencias=ls(SK.advertencias,ADV0);suspensoes=ls(SK.suspensoes,SUP0);
  document.getElementById('loginScreen').classList.add('hidden');
  document.getElementById('appScreen').classList.remove('hidden');
  document.getElementById('sbName').textContent=usuarioAtual.nome;
  document.getElementById('sbRole').textContent=lpf(usuarioAtual.perfil);
  const av=document.getElementById('sbAvatar');av.textContent=ini(usuarioAtual.nome);
  const cm={adm:'amber',coordenacao:'purple',professor:''};
  av.className='avatar '+(cm[usuarioAtual.perfil]||'');
  // Professor: esconde formulários e abas exclusivas do admin
  if(!podeCoord()){
    document.getElementById('formNovoAluno')?.classList.add('hidden');
    document.getElementById('acad-importacao')?.classList.add('hidden');
    const tabImp=document.querySelector('[onclick="showTab(\'acad\',\'importacao\',this)"]');
    if(tabImp)tabImp.style.display='none';
  }
  if(!podeUser()){
    document.getElementById('formUsuarios')?.classList.add('hidden');
    const tabUsr=document.querySelector('[onclick="showTab(\'acad\',\'usuarios\',this)"]');
    if(tabUsr)tabUsr.style.display='none';
  }
  populateSelects();renderDash();startClock();renderNotificacoes();
}

function populateSelects(){
  const inst=usuarios.filter(u=>['professor','prof_efetivo','prof_cnpj'].includes(u.perfil));
  document.getElementById('aTurmaId').innerHTML='<option value="">Selecione</option>'+turmas.filter(t=>t.status==='Ativa').map(t=>`<option value="${t.id}">${t.codigoSigop} — ${t.codigoInterno} (${t.curso})</option>`).join('');
  document.getElementById('aTurmaId').onchange=function(){const sel=turmas.find(t=>t.id===Number(this.value));if(sel)document.getElementById('aCurso').value=sel.curso;};
  document.getElementById('tInstrutor').innerHTML='<option value="">Sem instrutor</option>'+inst.map(i=>`<option value="${i.id}">${i.nome}</option>`).join('');
  const minh=turmas.filter(t=>t.status==='Ativa'&&(podeAdm()||t.instrutorId===usuarioAtual.id));
  document.getElementById('chamadaSigop').innerHTML='<option value="">Selecione</option>'+minh.map(t=>`<option value="${t.codigoSigop}">${t.codigoSigop} — ${t.codigoInterno} (${t.turno})</option>`).join('');
  document.getElementById('gradeSigop').innerHTML='<option value="">Todas</option>'+[...new Set(turmas.map(t=>t.codigoSigop))].map(s=>`<option value="${s}">${s}</option>`).join('');
  document.getElementById('relSigop').innerHTML='<option value="">Todas</option>'+[...new Set(turmas.map(t=>t.codigoSigop))].map(s=>`<option value="${s}">${s}</option>`).join('');
  const d=new Date(),off=d.getTimezoneOffset()*60000,iso=new Date(d.getTime()-off).toISOString().slice(0,7);
  document.getElementById('gradeMes').value=iso;document.getElementById('relMes').value=iso;
}

/* ── NAV ── */
function navDash(btn){document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));if(btn)btn.classList.add('active');document.getElementById('pageTitle').textContent='Painel';renderDash();}
function openDrawer(n){
  if(n==='notificacoes'){renderNotificacoes();}
  document.getElementById(`ov-${n}`).classList.add('open');
  if(n==='disciplinar'){renderAdvertencias();renderElegiveis();renderSuspensoes();renderHistorico();}
  if(n==='frequencia'){renderJustificativas();renderPendencias();}
  if(n==='academico'){renderAlunos();renderTurmas();renderUsuarios();renderCursos();atualizarSelectCursos();}
  if(n==='relatorios'){const ok=podeAdm();document.getElementById('relLock').classList.toggle('hidden',ok);document.getElementById('relContent').classList.toggle('hidden',!ok);if(ok)renderRelatorio();}
}
function closeDrawer(n){document.getElementById(`ov-${n}`).classList.remove('open');updateBadges();renderDash();}
function closeOvClick(e,id){if(e.target===e.currentTarget)document.getElementById(id).classList.remove('open');}
function showTab(g,t,btn){document.querySelectorAll(`[id^="${g}-"]`).forEach(p=>p.classList.remove('active'));document.getElementById(`${g}-${t}`).classList.add('active');if(btn){btn.closest('.tab-bar').querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');}}
function openMov(id){document.getElementById(id).classList.add('open');}
function closeMov(id){document.getElementById(id).classList.remove('open');}

function updateBadges(){
  const pa=advertencias.filter(a=>a.status==='Pendente').length;
  const pe=alunos.filter(a=>a.advertencias>=3).length;
  const disc=pa+pe;
  document.getElementById('nbDisc').textContent=disc;document.getElementById('nbDisc').classList.toggle('hidden',!disc);
  document.getElementById('nbPainel').textContent=pa;document.getElementById('nbPainel').classList.toggle('hidden',!pa);
  const h=hj(),dias=diasPT();
  const pf=turmas.filter(t=>{if(t.status!=='Ativa'||!t.diasSemana.includes(dias))return false;if(ehProfCNPJ()&&t.instrutorId!==usuarioAtual.id)return false;const al=alunos.filter(a=>a.turmaId===t.id&&a.status==='Em execução');return al.length&&frequencias.filter(f=>f.turmaSigop===t.codigoSigop&&f.data===h).length<al.length;}).length;
  document.getElementById('nbFreq').textContent=pf;document.getElementById('nbFreq').classList.toggle('hidden',!pf);
}

function startClock(){const el=document.getElementById('clock');const tick=()=>{el.textContent=new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});};tick();setInterval(tick,10000);}

function toast(msg,type=''){
  const wrap=document.getElementById('toastWrap');const t=document.createElement('div');t.className='toast '+type;
  const icons={success:'✓',error:'✕',warning:'⚠'};t.innerHTML=`<span>${icons[type]||''}</span> ${msg}`;
  wrap.appendChild(t);setTimeout(()=>{t.style.animation='tout .2s ease forwards';setTimeout(()=>t.remove(),200);},3500);
}

/* ── DASHBOARD ── */
function renderDash(){
  document.getElementById('kpiAtivos').textContent=alunos.filter(a=>a.status==='Em execução').length;
  document.getElementById('kpiFaltas').textContent=frequencias.filter(f=>f.status==='F').length;
  document.getElementById('kpiAdvert').textContent=advertencias.filter(a=>a.status==='Pendente').length;
  document.getElementById('kpiSusp').textContent=alunos.filter(a=>a.advertencias>=3).length;
  const h=hj(),dias=diasPT();
  document.getElementById('dashData').textContent=`Hoje: ${fd(h)} (${dias})`;
  const pt=turmas.filter(t=>{if(t.status!=='Ativa'||!t.diasSemana.includes(dias))return false;if(ehProfCNPJ()&&t.instrutorId!==usuarioAtual.id)return false;const al=alunos.filter(a=>a.turmaId===t.id&&a.status==='Em execução');return al.length&&frequencias.filter(f=>f.turmaSigop===t.codigoSigop&&f.data===h).length<al.length;});
  document.getElementById('tbDashPend').innerHTML=pt.length?pt.map(t=>{const inst=usuarios.find(u=>u.id===t.instrutorId);const al=alunos.filter(a=>a.turmaId===t.id&&a.status==='Em execução').length;const reg=frequencias.filter(f=>f.turmaSigop===t.codigoSigop&&f.data===h).length;return `<tr><td><span class="badge b-blue">${t.codigoSigop}</span></td><td>${t.codigoInterno}</td><td>${t.turno}</td><td>${inst?.nome||'—'}</td><td>${al}</td><td>${reg}/${al}</td><td><span class="badge b-amber">Pendente</span></td></tr>`;}).join(''):`<tr><td colspan="7" style="text-align:center;color:var(--text3);padding:24px">Sem pendências para hoje.</td></tr>`;
  const al=advertencias.filter(a=>a.status==='Pendente');
  document.getElementById('tbDashAlertas').innerHTML=al.length?al.map(a=>{const x=alunos.find(y=>y.id===a.alunoId);const t=turmas.find(y=>y.codigoSigop===a.turmaSigop);return `<tr><td><strong>${x?.nome||'—'}</strong></td><td>${t?.codigoInterno||a.turmaSigop}</td><td>${a.datasFalta.map(d=>`<span class="badge b-red" style="margin:1px;font-size:10px">${fd(d)}</span>`).join('')}</td><td>${sb(a.status)}</td><td style="display:flex;gap:6px;flex-wrap:wrap">${podeEmitir()?`<button class="btn btn-warn btn-sm" onclick="abrirAdvert(${a.id})">Emitir adv.</button>`:''} ${podeAdm()?`<button class="btn btn-outline btn-sm" onclick="justificarFalta(${a.alunoId},'${a.datasFalta[a.datasFalta.length-1]}')">Justificar</button>`:''}</td></tr>`;}).join(''):`<tr><td colspan="5" style="text-align:center;color:var(--text3);padding:24px">Sem alertas.</td></tr>`;
  // Card justificativas pendentes — só admin
  if(podeAdm()){
    const todasN=ls(SK.notificacoes,[]);
    const justifPend=todasN.filter(n=>n.tipo==='justificativa'&&!n.confirmado);
    const cardJust=document.getElementById('cardDashJustif');
    const tbJD=document.getElementById('tbDashJustif');
    if(cardJust)cardJust.classList.toggle('hidden',!justifPend.length);
    if(tbJD)tbJD.innerHTML=justifPend.length?justifPend.map(n=>`<tr><td><strong>${n.alunoNome}</strong></td><td>${fd(n.dataFalta||'')}</td><td>${n.emitidoPor}</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${n.motivo||'—'}</td><td style="white-space:nowrap"><button class="btn btn-success btn-sm" onclick="validarJustifNotif(${n.id})">Validar</button> <button class="btn btn-danger btn-sm" onclick="rejeitarJustifNotif(${n.id})">Rejeitar</button></td></tr>`).join(''):'';
  }
  updateBadges();
}

/* ── ACADÊMICO ── */
function salvarAluno(){
  const nome=document.getElementById('aNome').value.trim(),cpf=document.getElementById('aCpf').value.trim(),turmaId=Number(document.getElementById('aTurmaId').value),empresa=document.getElementById('aEmpresa').value.trim();
  const matricula=document.getElementById('aMatricula').value.trim();if(!nome||!cpf||!turmaId||!empresa||!matricula){toast('Preencha matrícula, nome, CPF, turma e empresa.','error');return;}
  if(alunos.some(a=>a.cpf===cpf)){toast('CPF já cadastrado.','error');return;}
  const t=turmas.find(x=>x.id===turmaId);
  const cursoAluno=t?.curso||document.getElementById('aCurso').value.trim();
  alunos.push({id:uid(),nome,cpf,matricula:matricula,curso:cursoAluno,turmaId,turmaSigop:t.codigoSigop,turma:t.codigoInterno,turno:t.turno,diasSemana:t.diasSemana,contratoInicio:document.getElementById('aInicio').value,contratoFim:document.getElementById('aFim').value,status:document.getElementById('aStatus').value,empresa,cnpj:document.getElementById('aCnpj').value,advertencias:0});
  sv(SK.alunos,alunos);['aNome','aCpf','aEmpresa','aCnpj','aMatricula'].forEach(id=>document.getElementById(id).value='');
  toast('Aluno cadastrado!','success');renderAlunos();populateSelects();updateBadges();
}

function renderAlunos(){
  const busca=(document.getElementById('searchAlunos').value||'').toLowerCase();
  const fl=alunos.filter(a=>`${a.nome} ${a.cpf} ${a.turma} ${a.turmaSigop} ${a.empresa}`.toLowerCase().includes(busca));
  document.getElementById('countAlunos').textContent=`${fl.length} aluno(s)`;
  document.getElementById('tbAlunos').innerHTML=fl.length?fl.map(a=>`<tr>
    <td style="font-size:12px;font-family:var(--mono);font-weight:600">${a.matricula||'—'}</td>
    <td><div style="font-weight:500">${a.nome}</div><div style="font-size:11px;color:var(--text3)">${a.curso}</div></td>
    <td style="font-size:12px;font-family:var(--mono)">${a.cpf}</td>
    <td><span class="badge b-blue" style="font-size:10px">${a.turmaSigop}</span> ${a.turma}</td>
    <td>${a.empresa}</td>
    <td style="font-size:12px">${a.contratoInicio?fd(a.contratoInicio)+' → '+fd(a.contratoFim):'—'}</td>
    <td>${sb(a.status)}</td>
    <td><span class="badge ${a.advertencias>=3?'b-red':a.advertencias>0?'b-amber':'b-gray'}">${a.advertencias}</span></td>
    <td>${podeAdm()?`<div style="display:flex;gap:4px;flex-wrap:wrap"><button class="btn btn-outline btn-sm" onclick="editarAluno(${a.id})">✏️</button><button class="btn btn-primary btn-sm" onclick="transferirAluno(${a.id})">🔄</button><button class="btn btn-danger btn-sm" onclick="excluirAluno(${a.id})">🗑️</button></div>`:'—'}</td>
  </tr>`).join(''):`<tr><td colspan="9" style="text-align:center;color:var(--text3);padding:28px">Nenhum aluno.</td></tr>`;
}

function editarAluno(id){
  const a=alunos.find(x=>x.id===id);if(!a)return;
  document.getElementById('editAlunoId').value=id;
  document.getElementById('editANome').value=a.nome;
  document.getElementById('editACpf').value=a.cpf;
  document.getElementById('editAMatricula').value=a.matricula||'';
  document.getElementById('editACurso').value=a.curso;
  document.getElementById('editAEmpresa').value=a.empresa;
  document.getElementById('editACnpj').value=a.cnpj||'';
  document.getElementById('editAInicio').value=a.contratoInicio||'';
  document.getElementById('editAFim').value=a.contratoFim||'';
  document.getElementById('editAStatus').value=a.status;
  openMov('mov-editAluno');
}

function salvarEdicaoAluno(){
  const id=Number(document.getElementById('editAlunoId').value);
  const a=alunos.find(x=>x.id===id);if(!a)return;
  a.nome=document.getElementById('editANome').value.trim();
  a.cpf=document.getElementById('editACpf').value.trim();
  a.matricula=document.getElementById('editAMatricula').value.trim();
  a.curso=document.getElementById('editACurso').value;
  a.empresa=document.getElementById('editAEmpresa').value.trim();
  a.cnpj=document.getElementById('editACnpj').value.trim();
  a.contratoInicio=document.getElementById('editAInicio').value;
  a.contratoFim=document.getElementById('editAFim').value;
  a.status=document.getElementById('editAStatus').value;
  sv(SK.alunos,alunos);
  closeMov('mov-editAluno');
  toast('Aluno atualizado!','success');
  renderAlunos();updateBadges();
}

function transferirAluno(id){
  const a=alunos.find(x=>x.id===id);if(!a)return;
  document.getElementById('transAlunoId').value=id;
  document.getElementById('transAlunoNome').textContent=a.nome;
  document.getElementById('transAlunoTurmaAtual').textContent=a.turmaSigop+' — '+a.turma;
  document.getElementById('transNovaTurma').innerHTML='<option value="">Selecione a nova turma</option>'+turmas.filter(t=>t.id!==a.turmaId&&t.status==='Ativa').map(t=>`<option value="${t.id}">${t.codigoSigop} — ${t.codigoInterno} (${t.curso})</option>`).join('');
  openMov('mov-transferirAluno');
}

function confirmarTransferencia(){
  const id=Number(document.getElementById('transAlunoId').value);
  const novoTurmaId=Number(document.getElementById('transNovaTurma').value);
  if(!novoTurmaId){toast('Selecione a nova turma.','error');return;}
  const a=alunos.find(x=>x.id===id);
  const t=turmas.find(x=>x.id===novoTurmaId);
  if(!a||!t){toast('Dados inválidos.','error');return;}
  a.turmaId=t.id;a.turmaSigop=t.codigoSigop;a.turma=t.codigoInterno;a.turno=t.turno;a.diasSemana=t.diasSemana;
  sv(SK.alunos,alunos);
  closeMov('mov-transferirAluno');
  toast(a.nome+' transferido(a) para '+t.codigoSigop+'!','success');
  renderAlunos();populateSelects();updateBadges();
}

function excluirAluno(id){
  if(!podeAdm()){toast('Sem permissão.','error');return;}
  const a=alunos.find(x=>x.id===id);
  document.getElementById('confirmTitle').textContent='Excluir Aluno';
  document.getElementById('confirmMsg').textContent='Deseja excluir o aluno '+(a?.nome||'')+' Esta ação não pode ser desfeita.';
  confirmCb=()=>{alunos=alunos.filter(x=>x.id!==id);sv(SK.alunos,alunos);renderAlunos();updateBadges();toast('Aluno excluído.','success');};
  openMov('mov-confirm');
}

function salvarTurma(){
  const sigop=document.getElementById('tSigop').value.trim(),interno=document.getElementById('tInterno').value.trim();
  const dias=[...document.querySelectorAll('input[name="tDia"]:checked')].map(c=>c.value).join(', ');
  const cursoV=document.getElementById('tCurso').value.trim();
  if(!sigop||!interno||!dias||!cursoV){toast('Preencha SIGOP, código interno, curso e ao menos um dia de aula.','error');return;}
  if(turmas.some(t=>t.codigoSigop===sigop||t.codigoInterno===interno)){toast('SIGOP ou código já existe.','error');return;}
  turmas.push({id:uid(),codigoSigop:sigop,codigoInterno:interno,curso:cursoV,turno:document.getElementById('tTurno').value,diasSemana:dias,status:document.getElementById('tStatus').value,instrutorId:Number(document.getElementById('tInstrutor').value)||null});
  sv(SK.turmas,turmas);['tSigop','tInterno'].forEach(id=>document.getElementById(id).value='');document.querySelectorAll('input[name="tDia"]').forEach(c=>c.checked=false);
  toast('Turma cadastrada!','success');renderTurmas();populateSelects();
}

function renderTurmas(){
  const inst=usuarios.filter(u=>['professor','prof_efetivo','prof_cnpj'].includes(u.perfil));
  // Professores só veem turmas Ativas; ADM/Coord veem todas
  const turmasFilt=podeAdm()?turmas:ehProfCNPJ()?turmas.filter(t=>t.instrutorId===usuarioAtual.id):turmas.filter(t=>t.status==='Ativa');
  document.getElementById('tbTurmas').innerHTML=turmasFilt.map(t=>{const i=usuarios.find(u=>u.id===t.instrutorId);const sel='<option value="">Sem instrutor</option>'+inst.map(x=>`<option value="${x.id}" ${x.id===t.instrutorId?'selected':''}>${x.nome}</option>`).join('');return `<tr><td><span class="badge b-blue">${t.codigoSigop}</span></td><td><strong>${t.codigoInterno}</strong></td><td>${t.curso}</td><td>${t.turno}</td><td>${t.diasSemana}</td><td>${i?.nome||'<span style="color:var(--text3)">—</span>'}</td><td>${sb(t.status)}</td><td>${podeCoord()?`<div style="display:flex;gap:6px;align-items:center"><select class="finput" style="width:140px;padding:5px 28px 5px 8px;font-size:12px" onchange="vincularInst(${t.id},this.value)">${sel}</select><button class="btn btn-outline btn-sm" onclick="editarTurma(${t.id})" title="Editar">✏️</button><button class="btn btn-danger btn-sm" onclick="excluirTurma(${t.id})" title="Excluir">🗑️</button></div>`:'—'}</td></tr>`;}).join('');
}

function vincularInst(tid,iid){const t=turmas.find(x=>x.id===tid);if(t){t.instrutorId=Number(iid)||null;sv(SK.turmas,turmas);toast('Instrutor atualizado!','success');populateSelects();}}

function salvarUsuario(){
  if(!podeUser()){toast('Sem permissão.','error');return;}
  const nome=document.getElementById('uNome').value.trim(),email=document.getElementById('uEmail').value.trim(),perfil=document.getElementById('uPerfil').value,senha=document.getElementById('uSenha').value||'123';
  if(!nome||!email){toast('Preencha nome e e-mail.','error');return;}
  if(!senha||senha.length<3){toast('Defina uma senha com pelo menos 3 caracteres.','error');return;}
  if(usuarios.some(u=>u.email.toLowerCase()===email.toLowerCase())){toast('E-mail já cadastrado.','error');return;}
  usuarios.push({id:uid(),nome,email,perfil,senha});sv(SK.usuarios,usuarios);
  ['uNome','uEmail'].forEach(id=>document.getElementById(id).value='');
  toast('Usuário criado!','success');renderUsuarios();populateSelects();
}

function renderUsuarios(){
  document.getElementById('tbUsuarios').innerHTML=usuarios.map(u=>`<tr>
    <td><div style="display:flex;align-items:center;gap:8px"><div class="avatar" style="width:28px;height:28px;font-size:11px">${ini(u.nome)}</div><strong>${u.nome}</strong></div></td>
    <td style="color:var(--text2);font-size:12px">${u.email}</td>
    <td>${sb(lpf(u.perfil))}</td>
    <td><div style="display:flex;gap:5px;flex-wrap:wrap">
      ${podeAdm()&&u.id!==usuarioAtual.id?`<button class="btn btn-outline btn-sm" onclick="editarUsuario(${u.id})" title="Editar">Editar</button><button class="btn btn-danger btn-sm" onclick="excluirUser(${u.id})" title="Excluir">Excluir</button>`:'—'}
    </div></td>
  </tr>`).join('');
}

function editarUsuario(id){
  const u=usuarios.find(x=>x.id===id);if(!u)return;
  document.getElementById('editUserId').value=id;
  document.getElementById('editUserNome').value=u.nome;
  document.getElementById('editUserEmail').value=u.email;
  document.getElementById('editUserPerfil').value=u.perfil;
  document.getElementById('editUserSenha').value='';
  openMov('mov-editUser');
}

function salvarEdicaoUsuario(){
  const id=Number(document.getElementById('editUserId').value);
  const u=usuarios.find(x=>x.id===id);if(!u)return;
  const nome=document.getElementById('editUserNome').value.trim();
  const email=document.getElementById('editUserEmail').value.trim();
  const perfil=document.getElementById('editUserPerfil').value;
  const senha=document.getElementById('editUserSenha').value;
  if(!nome||!email){toast('Preencha nome e e-mail.','error');return;}
  if(usuarios.some(x=>x.email.toLowerCase()===email.toLowerCase()&&x.id!==id)){toast('E-mail já em uso.','error');return;}
  u.nome=nome;u.email=email;u.perfil=perfil;
  if(senha&&senha.length>=3)u.senha=senha;
  sv(SK.usuarios,usuarios);
  closeMov('mov-editUser');
  toast('Usuário atualizado!','success');
  renderUsuarios();populateSelects();
}

function excluirUser(id){
  if(!podeAdm()){toast('Sem permissão.','error');return;}
  document.getElementById('confirmTitle').textContent='Excluir Usuário';
  document.getElementById('confirmMsg').textContent='Deseja excluir este usuário? Esta ação não pode ser desfeita.';
  confirmCb=()=>{usuarios=usuarios.filter(u=>u.id!==id);sv(SK.usuarios,usuarios);renderUsuarios();toast('Removido.','success');};
  openMov('mov-confirm');
}

/* ── IMPORTAÇÃO ── */
function baixarModelo(){
  const h=['Nome','CPF','Curso','Turma SIGOP','Turma','Turno','Dia da Semana','Início do Contrato','Término do Contrato','Status','Empresa','CNPJ CONTRATANTE'];
  const ex=['João da Silva','123.456.789-00','ADM CRJ','620500','JM70','Matutino','Seg, Qua, Sex','2026-04-01','2026-12-20','Em execução','Empresa Ex.','00.000.000/0001-00'];
  const csv='\uFEFF'+[h,ex].map(r=>r.join(';')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const uri = URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=uri;a.download='modelo_sigep.csv';
  document.body.appendChild(a);a.click();document.body.removeChild(a);
  URL.revokeObjectURL(uri);
}

function importar(event){
  const file=event.target.files?.[0];if(!file)return;
  const r=new FileReader();
  r.onload=e=>{try{const wb=XLSX.read(e.target.result,{type:'array'});const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows=XLSX.utils.sheet_to_json(sheet,{defval:'',raw:false,blankrows:false});
    if(rows.length === 0){toast('Arquivo vazio ou sem dados válidos.','error');event.target.value='';return;}let tc=0,ac=0;rows.forEach(row=>{const nome=String(row['Nome']||'').trim(),cpf=String(row['CPF']||'').trim(),tSigop=String(row['Turma SIGOP']||'').trim(),tInterna=String(row['Turma']||'').trim();if(!nome||!cpf||!tSigop||!tInterna)return;let t=turmas.find(x=>x.codigoSigop===tSigop);if(!t){t={id:uid(),codigoSigop:tSigop,codigoInterno:tInterna,curso:String(row['Curso']||'ADM CRJ').trim(),turno:String(row['Turno']||'Matutino').trim(),diasSemana:String(row['Dia da Semana']||'Seg, Qua, Sex').trim(),status:'Ativa',instrutorId:null};turmas.push(t);tc++;}if(!alunos.find(a=>a.cpf===cpf)){alunos.push({id:uid(),nome,cpf,matricula:'',curso:t.curso,turmaId:t.id,turmaSigop:t.codigoSigop,turma:t.codigoInterno,turno:t.turno,diasSemana:t.diasSemana,contratoInicio:String(row['Início do Contrato']||'').trim(),contratoFim:String(row['Término do Contrato']||'').trim(),status:String(row['Status']||'Em execução').trim(),empresa:String(row['Empresa']||'').trim(),cnpj:String(row['CNPJ CONTRATANTE']||'').trim(),advertencias:0});ac++;}});svAll();const res=document.getElementById('importResumo');res.textContent=`Importação: ${ac} aluno(s) e ${tc} turma(s) criados.`;res.classList.remove('hidden');toast(`${ac} aluno(s) importados!`,'success');populateSelects();renderAlunos();renderTurmas();updateBadges();}catch(err){toast('Erro ao importar.','error');}}; r.readAsArrayBuffer(file);event.target.value='';
}

/* ── FREQUÊNCIA ── */
function onChangeTurma(){
  const sigop=document.getElementById('chamadaSigop').value,info=document.getElementById('chamadaInfo'),card=document.getElementById('cardChamada');
  if(!sigop){info.classList.add('hidden');card.classList.add('hidden');return;}
  const t=turmas.find(x=>x.codigoSigop===sigop);
  if(t){const inst=usuarios.find(u=>u.id===t.instrutorId);info.innerHTML=`<strong>${t.codigoInterno}</strong> | ${t.curso} | ${t.turno} | Dias: ${t.diasSemana} | Instrutor: ${inst?.nome||'Não vinculado'}`;info.style.display='flex';info.classList.remove('hidden');}
  // Popular filtro empresa
  const empresasSel=document.getElementById('chamadaEmpresa');
  if(empresasSel){const empresas=[...new Set(alunos.filter(a=>a.turmaSigop===sigop&&a.status==='Em execução').map(a=>a.empresa))].filter(Boolean);empresasSel.innerHTML='<option value="">Todas as empresas</option>'+empresas.map(e=>`<option value="${e}">${e}</option>`).join('');}
  lancs={};renderChamada(sigop);card.classList.remove('hidden');
}
function renderChamada(sigop){
  sigop=sigop||document.getElementById('chamadaSigop').value;
  const empFiltro=(document.getElementById('chamadaEmpresa')?.value||'');
  let al=alunos.filter(a=>a.turmaSigop===sigop&&a.status==='Em execução');
  if(empFiltro)al=al.filter(a=>a.empresa===empFiltro);
  const isAdm=podeAdm();
  document.getElementById('tbChamada').innerHTML=al.length?al.map(a=>{
    const l=lancs[a.id]||{status:'P',justificativa:''};
    const optJ=isAdm?`<option value="J" ${l.status==='J'?'selected':''}>J — Justificado</option>`:'';
    const colJust=isAdm?`<td><input class="finput" style="font-size:12px;padding:5px 8px" placeholder="Justificativa..." value="${l.justificativa||''}" oninput="setLanc(${a.id},'justificativa',this.value)"></td>`:`<td style="color:var(--text3);font-size:12px;text-align:center">—</td>`;
    return `<tr><td><strong>${a.nome}</strong></td><td>${a.empresa}</td><td><select class="finput" style="width:120px;padding:5px 28px 5px 8px;font-size:12px" onchange="setLanc(${a.id},'status',this.value)"><option value="P" ${l.status==='P'?'selected':''}>P — Presença</option><option value="F" ${l.status==='F'?'selected':''}>F — Falta</option>${optJ}</select></td>${colJust}</tr>`;
  }).join(''):`<tr><td colspan="4" style="text-align:center;color:var(--text3);padding:24px">Nenhum aluno ativo.</td></tr>`;
}
function setLanc(aid,campo,val){if(!lancs[aid])lancs[aid]={status:'P',justificativa:''};lancs[aid][campo]=val;}
function marcarTodos(s){const sigop=document.getElementById('chamadaSigop').value;alunos.filter(a=>a.turmaSigop===sigop&&a.status==='Em execução').forEach(a=>lancs[a.id]={status:s,justificativa:''});renderChamada(sigop);}
function salvarChamada(){
  const sigop=document.getElementById('chamadaSigop').value,data=document.getElementById('chamadaData').value;
  if(!sigop||!data){toast('Selecione turma e data.','error');return;}
  const al=alunos.filter(a=>a.turmaSigop===sigop&&a.status==='Em execução');if(!al.length){toast('Nenhum aluno ativo.','error');return;}
  let n=0;al.forEach(a=>{if(frequencias.find(f=>f.alunoId===a.id&&f.turmaSigop===sigop&&f.data===data))return;const l=lancs[a.id]||{status:'P',justificativa:''};frequencias.push({id:uid(),alunoId:a.id,turmaSigop:sigop,data,status:l.status,justificativa:l.justificativa||'',validada:l.status!=='J'});if(l.status==='F')gerarAdv(a.id,sigop,data);n++;});
  sv(SK.frequencias,frequencias);sv(SK.advertencias,advertencias);lancs={};toast(`Chamada salva! ${n} registro(s).`,'success');updateBadges();renderDash();
}
function gerarAdv(alunoId,turmaSigop,data){const ex=advertencias.find(a=>a.alunoId===alunoId&&a.status==='Pendente');if(ex){if(!ex.datasFalta.includes(data))ex.datasFalta.push(data);}else advertencias.push({id:uid(),alunoId,turmaSigop,datasFalta:[data],motivos:['Faltas frequentes sem justificativa'],observacao:'',status:'Pendente',dataEmissao:''});}
function justificarFalta(alunoId,dataRef){
  const a=alunos.find(x=>x.id===alunoId);
  document.getElementById('justModalAlunoNome').textContent=(a?.nome||'Aluno')+' — '+fd(dataRef);
  document.getElementById('justModalData').value=dataRef;
  document.getElementById('justModalAlunoId').value=alunoId;
  document.getElementById('justModalTexto').value='';
  openMov('mov-justificarFalta');
}

function confirmarJustificativa(){
  const alunoId=Number(document.getElementById('justModalAlunoId').value);
  const dataRef=document.getElementById('justModalData').value;
  const motivo=document.getElementById('justModalMotivo').value;
  const textoRaw=document.getElementById('justModalTexto').value.trim();
  if(!textoRaw){toast('Informe a justificativa.','error');return;}
  const texto=motivo+': '+textoRaw;
  const reg=frequencias.find(f=>f.alunoId===alunoId&&f.data===dataRef);
  if(reg){reg.status='J';reg.justificativa=texto;reg.validada=false;}
  else{frequencias.push({id:uid(),alunoId,turmaSigop:alunos.find(x=>x.id===alunoId)?.turmaSigop||'',data:dataRef,status:'J',justificativa:texto,validada:false});}
  const adv=advertencias.find(a=>a.alunoId===alunoId&&a.status==='Pendente');
  if(adv){adv.datasFalta=adv.datasFalta.filter(d=>d!==dataRef);if(!adv.datasFalta.length)adv.status='Cancelada';}
  sv(SK.frequencias,frequencias);sv(SK.advertencias,advertencias);
  // Se for professor, notificar admin
  if(ehProfCNPJ()){
    const notifs=ls(SK.notificacoes,[]);
    const alunoJ=alunos.find(x=>x.id===alunoId);
    notifs.push({id:uid(),tipo:'justificativa',docId:null,alunoId,alunoNome:alunoJ?.nome||'',emitidoPor:usuarioAtual.nome,data:hj(),dataFalta:dataRef,motivo:texto,lido:false,confirmado:false});
    sv(SK.notificacoes,notifs);
    renderNotificacoes();
  }
  closeMov('mov-justificarFalta');
  toast('Justificativa registrada! Aguarda validação.','success');
  renderDash();updateBadges();
}
function renderJustificativas(){const filtro=document.getElementById('filtroJust').value;let lista=frequencias.filter(f=>f.status==='J');if(filtro==='pendente')lista=lista.filter(f=>!f.validada);if(filtro==='validada')lista=lista.filter(f=>f.validada);const empty=document.getElementById('emptyJust');if(!lista.length){empty.classList.remove('hidden');document.getElementById('tbJust').innerHTML='';return;}empty.classList.add('hidden');document.getElementById('tbJust').innerHTML=lista.map(f=>{const a=alunos.find(x=>x.id===f.alunoId),t=turmas.find(x=>x.codigoSigop===f.turmaSigop);return `<tr><td><strong>${a?.nome||'—'}</strong></td><td>${t?.codigoInterno||f.turmaSigop}</td><td>${fd(f.data)}</td><td>${f.justificativa||'—'}</td><td>${f.validada?'<span class="badge b-green">Validada</span>':'<span class="badge b-amber">Pendente</span>'}</td><td style="display:flex;gap:4px">${pode(['coordenacao','admin','adm'])&&!f.validada?`<button class="btn btn-success btn-sm" onclick="validarJust(${f.id})">Validar</button><button class="btn btn-danger btn-sm" onclick="rejeitarJust(${f.id})">Rejeitar</button>`:'—'}</td></tr>`;}).join('');}
function validarJust(id){const f=frequencias.find(x=>x.id===id);if(f){f.validada=true;sv(SK.frequencias,frequencias);toast('Validada!','success');renderJustificativas();}}
function rejeitarJust(id){const f=frequencias.find(x=>x.id===id);if(f){f.status='F';f.justificativa='';f.validada=false;gerarAdv(f.alunoId,f.turmaSigop,f.data);sv(SK.frequencias,frequencias);sv(SK.advertencias,advertencias);toast('Rejeitada.','warning');renderJustificativas();updateBadges();}}
function renderPendencias(){const h=hj(),dias=diasPT();document.getElementById('pendLabel').textContent=`Hoje: ${fd(h)} (${dias})`;const lista=turmas.filter(t=>{if(t.status!=='Ativa'||!t.diasSemana.includes(dias))return false;if(ehProfCNPJ()&&t.instrutorId!==usuarioAtual.id)return false;const al=alunos.filter(a=>a.turmaId===t.id&&a.status==='Em execução');return al.length&&frequencias.filter(f=>f.turmaSigop===t.codigoSigop&&f.data===h).length<al.length;});document.getElementById('tbPend').innerHTML=lista.length?lista.map(t=>{const inst=usuarios.find(u=>u.id===t.instrutorId),al=alunos.filter(a=>a.turmaId===t.id&&a.status==='Em execução').length,reg=frequencias.filter(f=>f.turmaSigop===t.codigoSigop&&f.data===h).length;return `<tr><td><span class="badge b-blue">${t.codigoSigop}</span></td><td><strong>${t.codigoInterno}</strong></td><td>${t.turno}</td><td>${inst?.nome||'—'}</td><td>${al}</td><td>${reg}/${al}</td><td><span class="badge b-amber">Pendente</span></td></tr>`;}).join(''):`<tr><td colspan="7" style="text-align:center;color:var(--text3);padding:28px">Sem pendências.</td></tr>`;}
function renderGrade(){const sigop=document.getElementById('gradeSigop').value,mes=document.getElementById('gradeMes').value,cont=document.getElementById('gradeWrap');if(!mes){cont.innerHTML='<div style="color:var(--text3);text-align:center;padding:28px">Selecione o mês.</div>';return;}let al=alunos;if(sigop)al=alunos.filter(a=>a.turmaSigop===sigop);const fr=frequencias.filter(f=>f.data.startsWith(mes)&&(!sigop||f.turmaSigop===sigop)),dts=[...new Set(fr.map(f=>f.data))].sort();if(!dts.length){cont.innerHTML='<div style="color:var(--text3);text-align:center;padding:28px">Sem registros.</div>';return;}let html=`<div style="overflow-x:auto"><table style="min-width:500px"><thead><tr><th style="position:sticky;left:0;background:var(--surface);z-index:1">Aluno</th><th>Turma</th>${dts.map(d=>`<th style="text-align:center;font-size:10px;padding:6px 3px">${fd(d)}</th>`).join('')}<th>P</th><th>F</th><th>J</th><th>%</th></tr></thead><tbody>`;al.forEach(a=>{const mapa={};fr.filter(f=>f.alunoId===a.id).forEach(f=>mapa[f.data]=f.status);const p=Object.values(mapa).filter(s=>s==='P').length,f=Object.values(mapa).filter(s=>s==='F').length,j=Object.values(mapa).filter(s=>s==='J').length,pct=p+f+j?Math.round(p/(p+f+j)*100):0;html+=`<tr><td style="position:sticky;left:0;background:var(--surface);font-weight:500">${a.nome}</td><td><span class="badge b-blue" style="font-size:10px">${a.turmaSigop}</span></td>${dts.map(d=>{const s=mapa[d];return `<td style="text-align:center"><span class="fc ${s?'fc-'+s:'fc-e'}">${s||'—'}</span></td>`;}).join('')}<td style="text-align:center;color:var(--green);font-weight:600">${p}</td><td style="text-align:center;color:var(--red);font-weight:600">${f}</td><td style="text-align:center;color:var(--amber);font-weight:600">${j}</td><td style="text-align:center"><span class="badge ${pct>=80?'b-green':pct>=60?'b-amber':'b-red'}">${pct}%</span></td></tr>`;});html+='</tbody></table></div><div style="margin-top:10px;display:flex;gap:12px;font-size:12px;color:var(--text3)"><span><span class="fc fc-P">P</span> Presença</span><span><span class="fc fc-F">F</span> Falta</span><span><span class="fc fc-J">J</span> Justificado</span></div>';cont.innerHTML=html;}

/* ── DISCIPLINAR ── */
function renderAdvertencias(){const lista=advertencias;const empty=document.getElementById('emptyAdvert');if(!lista.length){empty.classList.remove('hidden');document.getElementById('tbAdvert').innerHTML='';return;}empty.classList.add('hidden');document.getElementById('tbAdvert').innerHTML=lista.map(adv=>{const a=alunos.find(x=>x.id===adv.alunoId),t=turmas.find(x=>x.codigoSigop===adv.turmaSigop);return `<tr><td><strong>${a?.nome||'—'}</strong></td><td>${t?.codigoInterno||adv.turmaSigop}</td><td>${adv.datasFalta.map(d=>`<span class="badge b-red" style="margin:1px;font-size:10px">${fd(d)}</span>`).join('')}</td><td>${sb(adv.status)}</td><td style="display:flex;gap:5px;flex-wrap:wrap">${podeEmitir()&&adv.status==='Pendente'?`<button class="btn btn-warn btn-sm" onclick="abrirAdvert(${adv.id})">Emitir</button>`:''}${adv.status==='Emitida'?`<button class="btn btn-outline btn-sm" onclick="verDocAdvert(${adv.id})">Ver PDF</button>`:''}</td></tr>`;}).join('');}

function abrirAdvert(advId){
  const adv=advertencias.find(a=>a.id===advId);if(!adv)return;advAtualId=advId;
  const aluno=alunos.find(a=>a.id===adv.alunoId),turma=turmas.find(t=>t.codigoSigop===adv.turmaSigop);
  document.getElementById('advInfoAluno').innerHTML=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px"><div><span style="color:var(--text3)">Aluno:</span> <strong>${aluno?.nome}</strong></div><div><span style="color:var(--text3)">CPF:</span> ${aluno?.cpf}</div><div><span style="color:var(--text3)">Turma:</span> ${turma?.codigoInterno} (SIGOP: ${adv.turmaSigop})</div><div><span style="color:var(--text3)">Curso:</span> ${aluno?.curso}</div><div><span style="color:var(--text3)">Empresa:</span> ${aluno?.empresa}</div><div><span style="color:var(--text3)">Advertências:</span> <strong>${aluno?.advertencias||0}</strong></div></div>`;
  document.getElementById('advDatasFaltas').innerHTML=adv.datasFalta.map(d=>`<span class="badge b-red">${fd(d)}</span>`).join('');
  document.querySelectorAll('#advMotivos input[type=checkbox]').forEach(cb=>{cb.checked=adv.motivos.includes(cb.value);});
  document.getElementById('advObs').value=adv.observacao||'';
  document.getElementById('advAlertaSusp').classList.toggle('hidden',(aluno?.advertencias||0)<2);
  openMov('mov-advertencia');
}

function confirmarAdvertencia(){
  const adv=advertencias.find(a=>a.id===advAtualId);if(!adv)return;
  const motivos=[...document.querySelectorAll('#advMotivos input:checked')].map(c=>c.value);
  if(!motivos.length){toast('Selecione ao menos um motivo.','error');return;}
  adv.status='Emitida';adv.motivos=motivos;adv.observacao=document.getElementById('advObs').value;adv.dataEmissao=hj();
  adv.emitidoPor=usuarioAtual.id;adv.emitidoPorNome=usuarioAtual.nome;adv.emitidoPorPerfil=usuarioAtual.perfil;adv.confirmadoCoordenacao=false;
  const aluno=alunos.find(a=>a.id===adv.alunoId);if(aluno)aluno.advertencias=(aluno.advertencias||0)+1;
  sv(SK.advertencias,advertencias);sv(SK.alunos,alunos);
  closeMov('mov-advertencia');docAdvId=advAtualId;
  if(ehProfCNPJ()){
    toast('Advertência emitida! Coordenação será notificada.','success');
    criarNotificacao('advertencia',adv.id,adv.alunoId);
  } else {
    toast('Advertência emitida!','success');
  }
  verDocAdvert(advAtualId);
  renderAdvertencias();renderAlunos();renderElegiveis();updateBadges();renderDash();
}

function verDocAdvert(advId){
  docAdvId=advId;
  const adv=advertencias.find(a=>a.id===advId),aluno=alunos.find(a=>a.id===adv.alunoId),turma=turmas.find(t=>t.codigoSigop===adv.turmaSigop);
  document.getElementById('docAdvPreview').innerHTML=htmlAdvert(adv,aluno,turma);
  openMov('mov-docadvert');
}

function htmlAdvert(adv,aluno,turma){
  const TODOS_MOTIVOS=[
    'Faltas frequentes sem justificativa',
    'Atrasos constantes',
    'Desrespeito a instrutores, funcionários ou colegas.',
    'Não realização das atividades propostas',
    'Danos ao patrimônio da instituição',
    'Uso inadequado de tecnologia durante as aulas',
    'Comportamento inadequado no ambiente escolar',
    'Descumprimento das regras de conduta da instituição: Sem uniforme'
  ];
  const hoje=fdLong(hj());
  const checkItems=TODOS_MOTIVOS.map(m=>{
    const sel=adv.motivos.some(x=>m.toLowerCase().includes(x.toLowerCase().slice(0,15)));
    return `<div style="font-size:14px;margin-bottom:5px;display:flex;align-items:center">
      <span style="width:13px;height:13px;border:1px solid #000;display:inline-flex;align-items:center;justify-content:center;margin-right:10px;flex-shrink:0;font-size:11px">${sel?'✔':''}</span>
      ${m}
    </div>`;
  }).join('');
  return `<div style="font-family:Arial,sans-serif;background:#fff;color:#000;max-width:210mm;margin:0 auto;overflow:hidden">
    <!-- CABEÇALHO SVG -->
    <div style="width:100%;line-height:0;margin:0;padding:0">
      <svg viewBox="0 0 1000 110" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block">
        <path d="M 370,55 C 390,55 400,90 430,90 L 1000,90 L 1000,0 L 400,0 Z" fill="#27436b"/>
        <path d="M 0,0 L 510,0 C 540,0 520,55 490,55 L 0,55 Z" fill="#00a8e1"/>
        <text x="960" y="70" fill="white" font-family="Arial,Helvetica,sans-serif" font-weight="900" font-style="italic" font-size="44" letter-spacing="2" text-anchor="end">SEST SENAT</text>
      </svg>
    </div>
    <!-- CONTEÚDO -->
    <div style="padding:10mm 20mm 15mm 20mm">
      <h1 style="text-align:center;font-size:20px;margin:10px 0 20px;color:#000">ADVERTÊNCIA DISCIPLINAR</h1>
      <!-- GRID INFO -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
        <div style="background:#f2f2f2;padding:12px;font-size:13px;line-height:1.4">
          <p style="text-align:center;margin:0 0 10px"><strong>SEST SENAT</strong></p>
          <p style="margin:0 0 5px"><strong>Unidade Operacional</strong> Floriano Rangel Peixoto – DN122</p>
          <p style="margin:0 0 5px">Endereço: Rua Francisco Sousa dos Santos, 1025, Jardim Limoeiro, Serra/ES</p>
          <p style="margin:0 0 5px">CEP: 29.164-153</p>
          <p style="margin:0 0 5px">CNPJ: 73.471.963/0031-62</p>
          <p style="margin:0">Nº da declaração de habilitação no CNAP: 129527</p>
        </div>
        <div style="background:#f2f2f2;padding:12px;font-size:13px;line-height:1.4">
          <p style="margin:0 0 12px"><strong>NOME:</strong> ${aluno?.nome||''}</p>
          <p style="margin:0 0 12px"><strong>Código de Matrícula:</strong> ${aluno?.matricula||''}</p>
          <p style="margin:0 0 12px"><strong>Turma:</strong> ${turma?.codigoInterno||''}</p>
          <p style="margin:0"><strong>Curso:</strong> ${aluno?.curso||''}</p>
        </div>
      </div>
      <!-- INTRO -->
      <p style="font-size:14px;margin-bottom:15px;line-height:1.4">
        Este documento informa que o aprendiz identificado recebeu uma <strong>advertência disciplinar</strong>, conforme as regras do regulamento interno da instituição.
      </p>
      <hr style="border:none;border-top:2px solid #000;margin-bottom:15px">
      <!-- MOTIVOS -->
      <div style="margin-bottom:15px">
        <h2 style="color:#00a8e1;font-size:16px;margin-bottom:10px">Motivos da Advertência:</h2>
        ${checkItems}
      </div>
      <!-- OBS -->
      <div style="margin-top:15px;font-size:14px">
        <p style="margin-bottom:4px"><strong>OBS:</strong></p>
        <p style="min-height:24px;border-bottom:1px solid #ccc;padding-bottom:4px;font-size:13px">${adv.observacao||''}</p>
      </div>
      <!-- AVISO -->
      <p style="margin-top:20px;font-size:14px;line-height:1.4">
        Esta advertência será registrada no histórico escolar e enviada ao empregador para avaliação do desempenho e comportamento do aluno.
      </p>
      <!-- DATA -->
      <p style="text-align:center;margin:20px 0 30px;font-size:14px">${hoje}.</p>
      <!-- ASSINATURAS -->
      <div style="text-align:center;margin-bottom:35px">
        <div style="width:60%;border-top:1px solid #000;margin:0 auto 5px;padding-top:5px;font-size:14px">
          <p style="margin:3px 0"><strong>Victor Hugo Alves de Souza</strong></p>
          <p style="margin:3px 0">Técnico de Formação Profissional Pedagógico</p>
        </div>
      </div>
      <div style="text-align:left;font-size:14px">
        <p style="margin:8px 0"><strong>Recebido e assinado pelo aluno</strong></p>
        <p style="margin:8px 0">Assinatura: _________________________________________________</p>
        <p style="margin:8px 0">Data: ___/___/_______</p>
      </div>
    </div>
  </div>`;
}

function gerarPDFAdvert(){
  const adv=advertencias.find(a=>a.id===docAdvId);
  if(!adv){toast('Advertência não encontrada.','error');return;}
  const aluno=alunos.find(a=>a.id===adv.alunoId);
  const turma=turmas.find(t=>t.codigoSigop===adv.turmaSigop);
  toast('Gerando PDF...','success');
  // Render preview HTML into hidden container sized as A4
  const container=document.createElement('div');
  container.style.cssText='position:fixed;top:-99999px;left:-99999px;width:794px;background:#fff;z-index:-1';
  container.innerHTML=htmlAdvert(adv,aluno,turma);
  document.body.appendChild(container);
  setTimeout(function(){
    html2canvas(container,{scale:2,useCORS:true,backgroundColor:'#ffffff',width:794,windowWidth:794}).then(function(canvas){
      document.body.removeChild(container);
      const {jsPDF}=window.jspdf;
      const pdf=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
      const W=210,H=297;
      const imgData=canvas.toDataURL('image/jpeg',0.97);
      const canvasH=(canvas.height/canvas.width)*W;
      if(canvasH<=H){
        pdf.addImage(imgData,'JPEG',0,0,W,canvasH);
      } else {
        // multi-page
        let srcY=0;
        const pageH=canvas.width*(H/W);
        while(srcY<canvas.height){
          const chunk=Math.min(pageH,canvas.height-srcY);
          const tmpCanvas=document.createElement('canvas');
          tmpCanvas.width=canvas.width;tmpCanvas.height=chunk;
          tmpCanvas.getContext('2d').drawImage(canvas,0,srcY,canvas.width,chunk,0,0,canvas.width,chunk);
          pdf.addImage(tmpCanvas.toDataURL('image/jpeg',0.97),'JPEG',0,0,W,chunk*(W/canvas.width));
          srcY+=chunk;
          if(srcY<canvas.height)pdf.addPage();
        }
      }
      const fname='Advertencia_'+(aluno?.nome||'aluno').replace(/ /g,'_')+'_'+hj()+'.pdf';
      pdf.save(fname);
      toast('PDF gerado com sucesso!','success');
    }).catch(function(err){toast('Erro ao gerar PDF: '+err.message,'error');console.error(err);});
  },200);
}


/* ── SUSPENSÕES ── */
function renderElegiveis(){
  const lista=alunos.filter(a=>a.advertencias>=3&&a.status==='Em execução');
  const empty=document.getElementById('emptyEleg');
  if(!lista.length){empty.classList.remove('hidden');document.getElementById('tbEleg').innerHTML='';return;}
  empty.classList.add('hidden');
  document.getElementById('tbEleg').innerHTML=lista.map(a=>{const t=turmas.find(x=>x.id===a.turmaId);return `<tr><td><strong>${a.nome}</strong></td><td>${t?.codigoInterno||a.turma}</td><td>${a.empresa}</td><td><span class="badge b-red">${a.advertencias}</span></td><td>${podeEmitir()?`<button class="btn btn-danger btn-sm" onclick="abrirSusp(${a.id})">Emitir suspensão</button>`:'—'}</td></tr>`;}).join('');
}

function renderSuspensoes(){
  const empty=document.getElementById('emptySusp');
  if(!suspensoes.length){empty.classList.remove('hidden');document.getElementById('tbSusp').innerHTML='';return;}
  empty.classList.add('hidden');
  document.getElementById('tbSusp').innerHTML=suspensoes.map(s=>{const a=alunos.find(x=>x.id===s.alunoId),t=turmas.find(x=>x.codigoSigop===s.turmaSigop);return `<tr><td><strong>${a?.nome||'—'}</strong></td><td>${t?.codigoInterno||s.turmaSigop}</td><td style="max-width:140px;overflow:hidden;text-overflow:ellipsis">${s.motivoTexto||s.motivo}</td><td>${s.periodo.map(d=>`<span class="badge b-red" style="font-size:10px;margin:1px">${fd(d)}</span>`).join('')}</td><td><span class="badge b-green">${s.status}</span></td><td><button class="btn btn-outline btn-sm" onclick="verDocSusp(${s.id})">Ver PDF</button></td></tr>`;}).join('');
}

function abrirSusp(alunoId){
  suspAlunoId=alunoId;const a=alunos.find(x=>x.id===alunoId),t=turmas.find(x=>x.id===a.turmaId);
  document.getElementById('suspInfoAluno').innerHTML=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:13px"><div><span style="color:var(--text3)">Aluno:</span> <strong>${a.nome}</strong></div><div><span style="color:var(--text3)">Turma:</span> ${t?.codigoInterno||'—'}</div><div><span style="color:var(--text3)">Empresa:</span> ${a.empresa}</div><div><span style="color:var(--text3)">Advertências:</span> <span class="badge b-red">${a.advertencias}</span></div></div>`;
  document.getElementById('suspObs').value='';
  const sel=document.getElementById('suspMotivo');
  sel.onchange=()=>{document.getElementById('suspDiasNJ').classList.toggle('hidden',sel.value!=='falta_njustificada');};
  document.getElementById('suspDiasNJ').classList.add('hidden');
  openMov('mov-suspensao');
}

function confirmarSuspensao(){
  const motivoVal=document.getElementById('suspMotivo').value;
  const obs=document.getElementById('suspObs').value.trim();
  const diasNJ=document.getElementById('suspDiasInput').value.trim();
  if(!obs){toast('Preencha a descrição.','error');return;}
  const a=alunos.find(x=>x.id===suspAlunoId);
  // Usar os dias da turma do aluno
  const DIAS_MAP={Dom:0,Seg:1,Ter:2,Qua:3,Qui:4,Sex:5,Sab:6};
  const turmaAluno=turmas.find(t=>t.codigoSigop===a.turmaSigop);
  const diasAulaStr=turmaAluno?.diasSemana||a.diasSemana||'Seg, Ter, Qua, Qui, Sex';
  const diasAula=diasAulaStr.split(',').map(d=>DIAS_MAP[d.trim()]).filter(d=>d!==undefined);
  const periodo=[];let d=new Date();d.setDate(d.getDate()+1);
  let guard=0;
  while(periodo.length<3&&guard<90){
    guard++;
    if(diasAula.includes(d.getDay())){
      const off=d.getTimezoneOffset()*60000;
      periodo.push(new Date(d.getTime()-off).toISOString().slice(0,10));
    }
    d.setDate(d.getDate()+1);
  }
  const textoMotivos={falta_njustificada:`(x) Falta não justificada ao Programa nos dias: ${diasNJ}`,falta_grave:'(x) Falta disciplinar grave',outros:`(x) Outros: ${obs}`};
  const motivoTexto=textoMotivos[motivoVal]||obs;
  const novaSusp={id:uid(),alunoId:suspAlunoId,turmaSigop:a.turmaSigop,motivo:motivoVal,motivoTexto,obs:motivoVal==='outros'?'':`${obs}`,periodo,status:'Emitida',dataEmissao:hj()};
  novaSusp.emitidoPor=usuarioAtual.id;novaSusp.emitidoPorNome=usuarioAtual.nome;novaSusp.emitidoPorPerfil=usuarioAtual.perfil;novaSusp.confirmadoCoordenacao=false;
  // Mark aluno as having suspension - remove from elegíveis
  const aSusp=alunos.find(x=>x.id===suspAlunoId);
  if(aSusp){aSusp.suspensaoAtiva=true;aSusp.advertencias=0;}// reset adv count after suspension
  suspensoes.push(novaSusp);sv(SK.suspensoes,suspensoes);sv(SK.alunos,alunos);
  // Remove related notifications
  const notifs=ls(SK.notificacoes,[]);
  const notifsFiltradas=notifs.filter(n=>!(n.alunoId===suspAlunoId&&n.tipo==='advertencia'));
  sv(SK.notificacoes,notifsFiltradas);
  closeMov('mov-suspensao');
  docSuspId=novaSusp.id;
  if(ehProfCNPJ()){
    toast('Suspensão emitida! Coordenação será notificada.','success');
    criarNotificacao('suspensao',novaSusp.id,novaSusp.alunoId);
  } else {
    toast('Suspensão emitida!','success');
  }
  verDocSusp(novaSusp.id);
  renderSuspensoes();renderElegiveis();updateBadges();renderDash();
}

function verDocSusp(suspId){
  docSuspId=suspId;const s=suspensoes.find(x=>x.id===suspId),aluno=alunos.find(a=>a.id===s.alunoId),turma=turmas.find(t=>t.codigoSigop===s.turmaSigop);
  document.getElementById('docSuspPreview').innerHTML=htmlSusp(s,aluno,turma);
  openMov('mov-docsusp');
}

function htmlSusp(s,aluno,turma){
  const dataEmissao=s.dataEmissao?fdLong(s.dataEmissao):fdLong(hj());
  const localData=`Serra /ES, ${dataEmissao}`;
  const perStr=s.periodo.map(d=>fd(d)).join(', ');
  const nomes=['Técnico de Formação Profissional','Instrutor (a)','Responsável pelo Jovem','Nome do aluno e assinatura','Responsável na empresa'];
  const assinaturas=nomes.map(n=>`<div style="margin-top:28px"><div style="border-top:1px solid #000;width:240px;padding-top:4px;font-size:12px">${n}</div></div>`).join('');

  return `<div class="doc-preview" style="font-family:Arial,sans-serif;font-size:13px;line-height:1.8;color:#000;padding:24px 32px;max-width:680px;margin:0 auto">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;border-bottom:2px solid #003087;padding-bottom:16px">
    <div style="display:flex;align-items:center;gap:10px">
      <img src="${LOGO_AZUL}" style="height:50px;object-fit:contain;max-width:200px">
      <div style="font-size:9px;color:#555;line-height:1.4">Serviço Social do Transporte<br>Serviço Nacional de<br>Aprendizagem do Transporte</div>
    </div>
    <img src="${LOGO_JA}" style="height:70px;width:70px;object-fit:contain">
  </div>
  <h2 style="text-align:center;font-size:20px;font-weight:700;letter-spacing:1px;margin-bottom:24px">SUSPENSÃO</h2>
  <p style="text-align:justify;margin-bottom:20px">A coordenação pedagógica do programa Jovem Aprendiz, com base na Lei nº. 0.097 de 19/12/2000 e Decreto nº. 5598 de 01/12/2005, Capítulo V, Seção VIII, Artigo 28, inciso II, vem aplicar uma suspensão de 03 dias ${perStr} a (o) aluno (a) <strong>${aluno?.nome?.toUpperCase()||''}</strong> o Programa de Aprendizagem, em virtude do seguinte fato:</p>
  <p style="margin:5px 0">${s.motivo==='falta_njustificada'?s.motivoTexto:'( &nbsp;&nbsp; ) Falta não justificada ao Programa nos dias: _______'}</p>
  <p style="margin:5px 0">${s.motivo==='falta_grave'?s.motivoTexto:'( &nbsp;&nbsp; ) Falta disciplinar grave'}</p>
  <p style="margin:5px 0">${s.motivo==='outros'?s.motivoTexto:'( &nbsp;&nbsp; ) Outros: _______________________________________________'}</p>
  <p style="text-align:right;margin-top:24px">${localData}.</p>
  ${assinaturas}
  <div style="margin-top:40px;border-top:1px solid #000;padding-top:8px;text-align:center;font-size:10px;color:#555">
    SEST SENAT - UNIDADE DN122<br>
    Rua Francisco Sousa dos Santos, 1025, Jardim Limoeiro, Serra/ES - Cep: 29.164-153 – Tel.: (27) 3205-1050
  </div>
  </div>`;
}

function gerarPDFSusp(){
  const s=suspensoes.find(x=>x.id===docSuspId),aluno=alunos.find(a=>a.id===s.alunoId),turma=turmas.find(t=>t.codigoSigop===s.turmaSigop);
  try{
    const {jsPDF}=window.jspdf;
    const doc=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
    const W=210,mar=20;let y=15;

    // Header logos
    try{doc.addImage(LOGO_AZUL,'PNG',mar,y,65,18);}catch(e){}
    // Jovem Aprendiz logo
    try{doc.addImage(LOGO_JA,'PNG',W-mar-38,y,38,20);}catch(e){}

    // Submarca
    doc.setFontSize(7);doc.setFont('helvetica','normal');doc.setTextColor(80,80,80);
    doc.text('Serviço Social do Transporte',mar,y+22);
    doc.text('Serviço Nacional de Aprendizagem do Transporte',mar,y+27);

    y+=38;
    doc.setDrawColor(0,48,135);doc.setLineWidth(.8);doc.line(mar,y,W-mar,y);y+=8;

    // Título
    doc.setFontSize(16);doc.setFont('helvetica','bold');doc.setTextColor(0,0,0);
    doc.text('SUSPENSÃO',W/2,y,{align:'center'});y+=12;

    // Corpo
    const perStr=s.periodo.map(d=>fd(d)).join(', ');
    const corpo=`A coordenação pedagógica do programa Jovem Aprendiz, com base na Lei nº. 0.097 de 19/12/2000 e Decreto nº. 5598 de 01/12/2005, Capítulo V, Seção VIII, Artigo 28, inciso II, vem aplicar uma suspensão de 03 dias ${perStr} a (o) aluno (a) ${aluno?.nome?.toUpperCase()||''} o Programa de Aprendizagem, em virtude do seguinte fato:`;
    doc.setFontSize(11);doc.setFont('helvetica','normal');doc.setTextColor(0,0,0);
    const cLines=doc.splitTextToSize(corpo,W-mar*2);doc.text(cLines,mar,y);y+=cLines.length*6+8;

    // Motivos com checkbox
    const textoMot=s.motivoTexto||'';
    doc.text(textoMot.length>90?doc.splitTextToSize(textoMot,W-mar*2):textoMot,mar,y);
    if(textoMot.length>90){const l=doc.splitTextToSize(textoMot,W-mar*2);y+=l.length*6+4;}else{y+=8;}
    const mNJ = s.motivo==='falta_njustificada' ? '(x) Falta não justificada ao Programa nos dias: '+(s.motivoTexto.split(': ')[1]||'') : '(  ) Falta não justificada ao Programa nos dias:';
    const mFG = s.motivo==='falta_grave' ? '(x) Falta disciplinar grave' : '(  ) Falta disciplinar grave';
    const mOU = s.motivo==='outros' ? '(x) Outros: '+(s.motivoTexto.split(': ').slice(1).join(': ')||'') : '(  ) Outros:';
    [mNJ,mFG,mOU].forEach(m=>{const ml=doc.splitTextToSize(m,W-mar*2);doc.text(ml,mar,y);y+=ml.length*6+1;});

    y+=6;
    const dataEmissao=s.dataEmissao?fdLong(s.dataEmissao):fdLong(hj());
    doc.setFont('helvetica','normal');doc.text(`Serra /ES, ${dataEmissao}.`,W-mar-doc.getTextWidth(`Serra /ES, ${dataEmissao}.`),y);y+=18;

    // 5 assinaturas
    const sigs=['Técnico de Formação Profissional','Instrutor (a)','Responsável pelo Jovem','Nome do aluno e assinatura','Responsável na empresa'];
    sigs.forEach(sig=>{doc.setLineWidth(.3);doc.setDrawColor(0,0,0);doc.line(mar,y,mar+100,y);y+=5;doc.setFontSize(10);doc.text(sig,mar,y);y+=14;});

    // Footer
    doc.setDrawColor(0,0,0);doc.setLineWidth(.3);doc.line(mar,282,W-mar,282);
    doc.setFontSize(8);doc.setFont('helvetica','bold');doc.setTextColor(0,0,0);
    doc.text('SEST SENAT - UNIDADE DN122',W/2,286,{align:'center'});
    doc.setFont('helvetica','normal');doc.setFontSize(7.5);
    doc.text('Rua Francisco Sousa dos Santos, 1025, Jardim Limoeiro, Serra/ES - Cep: 29.164-153 – Tel.: (27) 3205-1050',W/2,290,{align:'center'});

    const pdfBlobS=doc.output('blob');const pdfUrlS=URL.createObjectURL(pdfBlobS);const linkS=document.createElement('a');linkS.href=pdfUrlS;linkS.download=`Suspensao_${(aluno?.nome||'aluno').replace(/ /g,'_')}_${s.periodo[0]||hj()}.pdf`;document.body.appendChild(linkS);linkS.click();setTimeout(()=>{document.body.removeChild(linkS);URL.revokeObjectURL(pdfUrlS);},1000);
    toast('PDF da suspensão gerado!','success');
  }catch(err){toast('Erro ao gerar PDF: '+err.message,'error');console.error(err);}
}

function renderHistorico(){document.getElementById('tbHistorico').innerHTML=alunos.map(a=>{const ta=advertencias.filter(x=>x.alunoId===a.id).length,ts=suspensoes.filter(x=>x.alunoId===a.id).length,t=turmas.find(x=>x.id===a.turmaId);let sit=a.advertencias>=3?'<span class="badge b-red">Elegível p/ suspensão</span>':a.advertencias>0?'<span class="badge b-amber">Com advertências</span>':'<span class="badge b-green">Regular</span>';return `<tr><td><strong>${a.nome}</strong></td><td>${t?.codigoInterno||a.turma}</td><td>${a.empresa}</td><td>${sb(a.status)}</td><td style="text-align:center"><span class="badge ${ta>0?'b-amber':'b-gray'}">${ta}</span></td><td style="text-align:center"><span class="badge ${ts>0?'b-red':'b-gray'}">${ts}</span></td><td>${sit}</td></tr>`;}).join('');}

/* ── RELATÓRIOS ── */
function getRelDados(){const mes=document.getElementById('relMes').value,sigop=document.getElementById('relSigop').value,turno=document.getElementById('relTurno').value,emp=(document.getElementById('relEmpresa').value||'').toLowerCase(),status=document.getElementById('relStatus').value;let base=alunos.filter(a=>{if(sigop&&a.turmaSigop!==sigop)return false;if(turno&&a.turno!==turno)return false;if(emp&&!a.empresa.toLowerCase().includes(emp))return false;if(status&&a.status!==status)return false;return true;});const fr=frequencias.filter(f=>f.data.startsWith(mes)),dts=[...new Set(fr.filter(f=>base.some(a=>a.id===f.alunoId)).map(f=>f.data))].sort();const linhas=base.map(a=>{const regs=fr.filter(f=>f.alunoId===a.id),mapa={};regs.forEach(r=>mapa[r.data]=r.status);return {aluno:a,mapa,p:regs.filter(r=>r.status==='P').length,f:regs.filter(r=>r.status==='F').length,j:regs.filter(r=>r.status==='J').length};});return {mes,dts,linhas};}
function renderRelatorio(){const {mes,dts,linhas}=getRelDados();document.getElementById('relTitulo').textContent=`Relatório Mensal — ${mes}`;document.getElementById('relSub').textContent=`${linhas.length} aluno(s) — ${dts.length} datas letivas`;const empty=document.getElementById('relEmpty');if(!linhas.length){empty.classList.remove('hidden');document.getElementById('relHead').innerHTML='';document.getElementById('relBody').innerHTML='';return;}empty.classList.add('hidden');document.getElementById('relHead').innerHTML=`<tr><th>Aluno</th><th>Turma</th><th>Empresa</th>${dts.map(d=>`<th style="text-align:center;font-size:10px;padding:6px 3px">${fd(d)}</th>`).join('')}<th>P</th><th>F</th><th>FJ</th><th>FI</th><th>Status</th></tr>`;document.getElementById('relBody').innerHTML=linhas.map(({aluno:a,mapa,p,f,j})=>`<tr><td><strong>${a.nome}</strong></td><td><span class="badge b-blue" style="font-size:10px">${a.turmaSigop}</span></td><td>${a.empresa}</td>${dts.map(d=>{const s=mapa[d];return `<td style="text-align:center"><span class="fc ${s?'fc-'+s:'fc-e'}" style="font-size:10px">${s||'—'}</span></td>`;}).join('')}<td style="text-align:center;color:var(--green);font-weight:600">${p}</td><td style="text-align:center;color:var(--red);font-weight:600">${f}</td><td style="text-align:center;color:var(--amber);font-weight:600">${j}</td><td style="text-align:center;color:var(--red);font-weight:600">${f}</td><td>${sb(a.status)}</td></tr>`).join('');}
function exportPDF(){if(!podeAdm()){toast('Acesso restrito.','error');return;}const {mes,dts,linhas}=getRelDados();try{const {jsPDF}=window.jspdf;const doc=new jsPDF({orientation:'landscape',unit:'mm',format:'a4'});try{doc.addImage(LOGO_AZUL,'PNG',14,6,40,10);}catch(e){}doc.setFontSize(13);doc.setFont('helvetica','bold');doc.setTextColor(13,59,140);doc.text('SIGEP — Relatório Mensal de Frequência',62,11);doc.setFontSize(8);doc.setFont('helvetica','normal');doc.setTextColor(87,83,74);doc.text(`Mês: ${mes} | Gerado: ${new Date().toLocaleString('pt-BR')} | Usuário: ${usuarioAtual.nome}`,62,17);const head=[['Aluno','Turma','Empresa',...dts.map(d=>fd(d)),'P','F','FJ','FI','Status']];const body=linhas.map(({aluno:a,mapa,p,f,j})=>[a.nome,a.turmaSigop,a.empresa,...dts.map(d=>mapa[d]||'—'),p,f,j,f,a.status]);doc.autoTable({startY:22,head,body,styles:{fontSize:6,cellPadding:2},headStyles:{fillColor:[13,59,140]},alternateRowStyles:{fillColor:[244,243,239]}});const fy=doc.lastAutoTable?.finalY||30;doc.setFontSize(8);doc.setTextColor(87,83,74);doc.text(`Total: ${linhas.length} aluno(s)`,14,fy+8);const pdfBlob2=doc.output('blob');const pdfUrl2=URL.createObjectURL(pdfBlob2);const link2=document.createElement('a');link2.href=pdfUrl2;link2.download=`Relatorio_Mensal_${mes}.pdf`;document.body.appendChild(link2);link2.click();setTimeout(()=>{document.body.removeChild(link2);URL.revokeObjectURL(pdfUrl2);},1000);toast('PDF exportado!','success');}catch(err){toast('Erro: '+err.message,'error');}}
function exportXLSX(){if(!podeAdm()){toast('Acesso restrito.','error');return;}const {mes,dts,linhas}=getRelDados();const h=['Nome','Turma SIGOP','Empresa',...dts.map(d=>fd(d)),'Presenças','Faltas','F.Justificadas','F.Injustificadas','Status'];const rows=linhas.map(({aluno:a,mapa,p,f,j})=>[a.nome,a.turmaSigop,a.empresa,...dts.map(d=>mapa[d]||''),p,f,j,f,a.status]);const ws=XLSX.utils.aoa_to_sheet([h,...rows]);const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Frequência');XLSX.writeFile(wb,`Relatorio_Mensal_${mes}.xlsx`);toast('XLSX exportado!','success');}



/* ── CURSOS ── */
let cursos = ls('sigep_cursos', []);

function salvarCurso(){
  const nome = document.getElementById('cursoNome').value.trim();
  const codigo = document.getElementById('cursoCodigo').value.trim();
  const cargaHoraria = document.getElementById('cursoCargaHoraria').value;
  const duracao = document.getElementById('cursoDuracao').value;
  const descricao = document.getElementById('cursoDescricao').value.trim();
  const status = document.getElementById('cursoStatus').value;
  
  if(!nome){toast('Preencha o nome do curso.','error');return;}
  if(cursos.some(c=>c.nome.toLowerCase()===nome.toLowerCase())){toast('Curso já cadastrado.','error');return;}
  
  cursos.push({
    id:uid(),
    nome,
    codigo:codigo||'',
    cargaHoraria:parseInt(cargaHoraria)||0,
    duracao:parseInt(duracao)||0,
    descricao:descricao||'',
    status,
    dataCriacao:hj()
  });
  
  sv('sigep_cursos',cursos);
  ['cursoNome','cursoCodigo','cursoCargaHoraria','cursoDuracao','cursoDescricao'].forEach(id=>document.getElementById(id).value='');
  toast('Curso cadastrado!','success');
  renderCursos();
  atualizarSelectCursos();
}

function renderCursos(){
  const busca=(document.getElementById('searchCursos')?.value||'').toLowerCase();
  const fl=cursos.filter(c=>`${c.nome} ${c.codigo} ${c.descricao}`.toLowerCase().includes(busca));
  if(document.getElementById('countCursos'))document.getElementById('countCursos').textContent=`${fl.length} curso(s)`;
  if(!document.getElementById('tbCursos'))return;
  document.getElementById('tbCursos').innerHTML=fl.length?fl.map(c=>`<tr>
    <td><div style="font-weight:500">${c.nome}</div><div style="font-size:11px;color:var(--text3)">${c.descricao||'—'}</div></td>
    <td><span class="badge b-gray">${c.codigo||'—'}</span></td>
    <td>${c.cargaHoraria?c.cargaHoraria+'h':'—'}</td>
    <td>${c.duracao?c.duracao+' meses':'—'}</td>
    <td>${sb(c.status)}</td>
    <td>${podeAdm()?`<div style="display:flex;gap:4px;flex-wrap:wrap"><button class="btn btn-outline btn-sm" onclick="editarCurso(${c.id})">Editar</button><button class="btn btn-danger btn-sm" onclick="excluirCurso(${c.id})">Excluir</button></div>`:'—'}</td>
  </tr>`).join(''):`<tr><td colspan="6" style="text-align:center;color:var(--text3);padding:28px">Nenhum curso cadastrado.</td></tr>`;
}

function atualizarSelectCursos(){
  const selects = document.querySelectorAll('#tCurso, #editTCurso');
  selects.forEach(sel=>{
    if(!sel)return;
    const curVal = sel.value;
    sel.innerHTML = '<option value="">Selecione um curso</option>' + 
      cursos.filter(c=>c.status==='Ativo').map(c=>`<option value="${c.nome}">${c.nome}</option>`).join('');
    sel.value = curVal;
  });
}

function editarCurso(id){
  const c=cursos.find(x=>x.id===id);
  if(!c)return;
  document.getElementById('editCursoId').value=id;
  document.getElementById('editCursoNome').value=c.nome;
  document.getElementById('editCursoCodigo').value=c.codigo||'';
  document.getElementById('editCursoCargaHoraria').value=c.cargaHoraria||'';
  document.getElementById('editCursoDuracao').value=c.duracao||'';
  document.getElementById('editCursoDescricao').value=c.descricao||'';
  document.getElementById('editCursoStatus').value=c.status;
  openMov('mov-editCurso');
}

function salvarEdicaoCurso(){
  const id=Number(document.getElementById('editCursoId').value);
  const c=cursos.find(x=>x.id===id);
  if(!c)return;
  c.nome=document.getElementById('editCursoNome').value.trim();
  c.codigo=document.getElementById('editCursoCodigo').value.trim();
  c.cargaHoraria=parseInt(document.getElementById('editCursoCargaHoraria').value)||0;
  c.duracao=parseInt(document.getElementById('editCursoDuracao').value)||0;
  c.descricao=document.getElementById('editCursoDescricao').value.trim();
  c.status=document.getElementById('editCursoStatus').value;
  sv('sigep_cursos',cursos);
  closeMov('mov-editCurso');
  toast('Curso atualizado!','success');
  renderCursos();
  atualizarSelectCursos();
}

function excluirCurso(id){
  if(!podeAdm()){toast('Sem permissão.','error');return;}
  const c=cursos.find(x=>x.id===id);
  document.getElementById('confirmTitle').textContent='Excluir Curso';
  document.getElementById('confirmMsg').textContent='Deseja excluir o curso '+(c?.nome||'')+'? Esta ação não pode ser desfeita.';
  confirmCb=()=>{cursos=cursos.filter(x=>x.id!==id);sv('sigep_cursos',cursos);renderCursos();atualizarSelectCursos();toast('Curso excluído.','success');};
  openMov('mov-confirm');
}


/* ── TURMAS EDIT/DELETE (coordinator only) ── */
function editarTurma(id){
  if(!podeAdm()){toast('Sem permissão.','error');return;}
  const t=turmas.find(x=>x.id===id);if(!t)return;
  document.getElementById('editTurmaId').value=id;
  document.getElementById('editTSigop').value=t.codigoSigop;
  document.getElementById('editTInterno').value=t.codigoInterno;
  document.getElementById('editTCurso').value=t.curso;
  document.getElementById('editTTurno').value=t.turno;
  const diasArr=t.diasSemana.split(',').map(d=>d.trim());document.querySelectorAll('input[name="editDia"]').forEach(c=>c.checked=diasArr.includes(c.value));
  document.getElementById('editTStatus').value=t.status;
  const sel=document.getElementById('editTInstrutor');
  sel.innerHTML='<option value="">Sem instrutor</option>'+usuarios.filter(u=>['professor','prof_efetivo','prof_cnpj'].includes(u.perfil)).map(i=>`<option value="${i.id}" ${i.id===t.instrutorId?'selected':''}>${i.nome}</option>`).join('');
  openMov('mov-editTurma');
}

function salvarEdicaoTurma(){
  const id=Number(document.getElementById('editTurmaId').value);
  const t=turmas.find(x=>x.id===id);if(!t)return;
  const antes={...t};
  t.codigoSigop=document.getElementById('editTSigop').value.trim();
  t.codigoInterno=document.getElementById('editTInterno').value.trim();
  t.curso=document.getElementById('editTCurso').value;
  t.turno=document.getElementById('editTTurno').value;
  t.diasSemana=[...document.querySelectorAll('input[name="editDia"]:checked')].map(c=>c.value).join(', ');
  t.status=document.getElementById('editTStatus').value;
  t.instrutorId=Number(document.getElementById('editTInstrutor').value)||null;
  // Track change
  if(!t.historico)t.historico=[];
  t.historico.push({data:hj(),usuario:usuarioAtual.nome,perfil:usuarioAtual.perfil,acao:'Edição',antes:JSON.stringify(antes)});
  sv(SK.turmas,turmas);
  closeMov('mov-editTurma');
  toast('Turma atualizada!','success');
  renderTurmas();populateSelects();
}

function excluirTurma(id){
  if(!podeAdm()){toast('Sem permissão.','error');return;}
  const t=turmas.find(x=>x.id===id);
  const alunosVinc=alunos.filter(a=>a.turmaId===id).length;
  if(alunosVinc>0){toast(`Turma tem ${alunosVinc} aluno(s) vinculado(s). Desvincule antes.`,'error');return;}
  document.getElementById('confirmTitle').textContent='Excluir Turma';
  document.getElementById('confirmMsg').textContent=`Deseja excluir a turma ${t?.codigoSigop} - ${t?.codigoInterno}? Esta ação não pode ser desfeita.`;
  confirmCb=()=>{
    turmas=turmas.filter(x=>x.id!==id);
    sv(SK.turmas,turmas);
    toast('Turma excluída.','success');
    renderTurmas();populateSelects();
  };
  openMov('mov-confirm');
}

/* ── NOTIFICAÇÕES ── */
function criarNotificacao(tipo,docId,alunoId){
  if(!sk_notif)return;
  const notifs=ls(SK.notificacoes,[]);
  const aluno=alunos.find(a=>a.id===alunoId);
  notifs.push({id:uid(),tipo,docId,alunoId,alunoNome:aluno?.nome||'',emitidoPor:usuarioAtual.nome,data:hj(),lido:false,confirmado:false});
  sv(SK.notificacoes,notifs);
  renderNotificacoes();
}

function renderNotificacoes(){
  const todasNotifs=ls(SK.notificacoes,[]);
  const notifs=todasNotifs.filter(n=>!n.confirmado);
  // History table
  const hist=todasNotifs.filter(n=>n.confirmado);
  const tbHist=document.getElementById('tbNotifHist');
  if(tbHist){tbHist.innerHTML=hist.length?hist.map(n=>`<tr><td>${n.tipo==='advertencia'?'⚠️ Advertência':'🚫 Suspensão'}</td><td>${n.alunoNome}</td><td>${n.emitidoPor}</td><td>${fd(n.data)}</td><td>${n.confirmadoPor||'—'}</td><td>${fd(n.confirmadoEm||'')}</td></tr>`).join(''):'<tr><td colspan="6" style="text-align:center;color:var(--text3);padding:20px">Sem confirmações.</td></tr>';}
  const badge=document.getElementById('notifBadge');
  if(badge){badge.textContent=notifs.length;badge.classList.toggle('hidden',!notifs.length);}
  const cont=document.getElementById('notifLista');
  if(!cont)return;
  cont.innerHTML=notifs.length?notifs.map(n=>{
    let icone,titulo,detalhe,acoes='';
    if(n.tipo==='justificativa'){
      icone='📋';titulo='Justificativa de falta — aguarda validação';
      detalhe=`Aluno: <strong>${n.alunoNome}</strong> | Falta: ${fd(n.dataFalta||'')} | Enviado por: ${n.emitidoPor} | ${fd(n.data)}<br><em style="color:var(--text3)">${n.motivo||''}</em>`;
      if(podeAdm())acoes=`<button class="btn btn-success btn-sm" onclick="validarJustifNotif(${n.id})">Validar</button> <button class="btn btn-danger btn-sm" onclick="rejeitarJustifNotif(${n.id})">Rejeitar</button>`;
    } else if(n.tipo==='advertencia'){
      icone='⚠️';titulo='Advertência emitida por professor';
      detalhe=`Aluno: <strong>${n.alunoNome}</strong> | Por: ${n.emitidoPor} | ${fd(n.data)}`;
      if(podeAdm())acoes=`<button class="btn btn-success btn-sm" onclick="confirmarNotificacao(${n.id})">Confirmar recebimento</button>`;
    } else {
      icone='🚫';titulo='Suspensão emitida por professor';
      detalhe=`Aluno: <strong>${n.alunoNome}</strong> | Por: ${n.emitidoPor} | ${fd(n.data)}`;
      if(podeAdm())acoes=`<button class="btn btn-success btn-sm" onclick="confirmarNotificacao(${n.id})">Confirmar recebimento</button>`;
    }
    return `<div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;gap:12px">
      <div style="font-size:20px;padding-top:2px;line-height:1">${icone}</div>
      <div style="flex:1"><div style="font-weight:600;font-size:13px">${titulo}</div><div style="font-size:12px;color:var(--text2);margin-top:4px;line-height:1.5">${detalhe}</div></div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:flex-start">${acoes}</div>
    </div>`;
  }).join(''):'<div style="padding:24px;text-align:center;color:var(--text3)">Sem notificações pendentes.</div>';
}

function confirmarNotificacao(nid){
  const notifs=ls(SK.notificacoes,[]);
  const n=notifs.find(x=>x.id===nid);
  if(n){n.confirmado=true;n.confirmadoPor=usuarioAtual.nome;n.confirmadoEm=hj();}
  sv(SK.notificacoes,notifs);
  toast('Recebimento confirmado!','success');
  renderNotificacoes();
}

const sk_notif=true;

function runConfirm(){if(confirmCb){confirmCb();confirmCb=null;}closeMov('mov-confirm');}
function limparDados(){document.getElementById('confirmTitle').textContent='Limpar todos os dados';document.getElementById('confirmMsg').textContent='Apagará TODOS os dados locais. Esta ação não pode ser desfeita.';confirmCb=()=>{Object.values(SK).forEach(k=>localStorage.removeItem(k));toast('Dados limpos. Recarregando...','warning');setTimeout(()=>location.reload(),1500);};openMov('mov-confirm');}

/* ── ADVERTÊNCIA MANUAL ── */
function abrirAdvManual(){
  if(!podeEmitir()){toast('Sem permissão.','error');return;}
  document.getElementById('advManualAluno').innerHTML='<option value="">Selecione o aluno</option>'+alunos.filter(a=>a.status==='Em execução').map(a=>`<option value="${a.id}">${a.nome} (${a.turmaSigop})</option>`).join('');
  document.getElementById('advManualInfo').classList.add('hidden');
  document.querySelectorAll('input[name="advManM"]').forEach(cb=>cb.checked=false);
  document.getElementById('advManualObs').value='';
  openMov('mov-advManual');
}

function atualizarInfoAdvManual(){
  const id=Number(document.getElementById('advManualAluno').value);
  const info=document.getElementById('advManualInfo');
  if(!id){info.classList.add('hidden');return;}
  const a=alunos.find(x=>x.id===id),t=turmas.find(x=>x.id===a?.turmaId);
  if(a){info.innerHTML=`<strong>${a.nome}</strong> | Turma: ${t?.codigoInterno||a.turma} | Empresa: ${a.empresa} | Advertências: <span class="badge ${a.advertencias>=3?'b-red':a.advertencias>0?'b-amber':'b-gray'}">${a.advertencias}</span>`;info.classList.remove('hidden');}
}

function confirmarAdvManual(){
  const alunoId=Number(document.getElementById('advManualAluno').value);
  if(!alunoId){toast('Selecione o aluno.','error');return;}
  // Ler checkboxes APENAS do modal de advertência manual
  const motivos=[...document.querySelectorAll('#mov-advManual input[name="advManM"]:checked')].map(cb=>cb.value);
  const obs=document.getElementById('advManualObs').value.trim();
  if(!motivos.length){toast('Selecione ao menos um motivo.','error');return;}
  if(!obs){toast('Informe a observação.','error');return;}
  const a=alunos.find(x=>x.id===alunoId);
  // Criar a advertência já no status Emitida diretamente
  const novaAdv={id:uid(),alunoId,turmaSigop:a.turmaSigop,datasFalta:[],motivos,observacao:obs,status:'Emitida',dataEmissao:hj(),manual:true,emitidoPor:usuarioAtual.id,emitidoPorNome:usuarioAtual.nome,emitidoPorPerfil:usuarioAtual.perfil};
  advertencias.push(novaAdv);
  if(a)a.advertencias=(a.advertencias||0)+1;
  sv(SK.advertencias,advertencias);sv(SK.alunos,alunos);
  closeMov('mov-advManual');
  toast('Advertência emitida!','success');
  docAdvId=novaAdv.id;
  verDocAdvert(novaAdv.id);
  renderAdvertencias();renderAlunos();renderElegiveis();updateBadges();renderDash();
}

/* ── VALIDAR/REJEITAR JUSTIFICATIVA VIA NOTIFICAÇÃO ── */
function validarJustifNotif(nid){
  const notifs=ls(SK.notificacoes,[]);
  const n=notifs.find(x=>x.id===nid);
  if(!n)return;
  // Validar a frequência correspondente
  const f=frequencias.find(x=>x.alunoId===n.alunoId&&x.data===n.dataFalta);
  if(f){f.validada=true;sv(SK.frequencias,frequencias);}
  // Remover advertência vinculada se existir
  const adv=advertencias.find(a=>a.alunoId===n.alunoId&&a.status==='Pendente');
  if(adv){adv.datasFalta=adv.datasFalta.filter(d=>d!==n.dataFalta);if(!adv.datasFalta.length)adv.status='Cancelada';sv(SK.advertencias,advertencias);}
  n.confirmado=true;n.confirmadoPor=usuarioAtual.nome;n.confirmadoEm=hj();
  sv(SK.notificacoes,notifs);
  toast('Justificativa validada!','success');
  renderNotificacoes();renderDash();updateBadges();
}

function rejeitarJustifNotif(nid){
  const notifs=ls(SK.notificacoes,[]);
  const n=notifs.find(x=>x.id===nid);
  if(!n)return;
  // Reverter frequência para F
  const f=frequencias.find(x=>x.alunoId===n.alunoId&&x.data===n.dataFalta);
  if(f){f.status='F';f.justificativa='';f.validada=false;sv(SK.frequencias,frequencias);gerarAdv(n.alunoId,f.turmaSigop,n.dataFalta);}
  n.confirmado=true;n.confirmadoPor=usuarioAtual.nome;n.confirmadoEm=hj();
  sv(SK.notificacoes,notifs);sv(SK.advertencias,advertencias);
  toast('Justificativa rejeitada.','warning');
  renderNotificacoes();renderDash();updateBadges();
}

/* ── IMPRIMIR DOCUMENTO SEM GERAR ARQUIVO ── */
function imprimirDoc(previewId){
  const el=document.getElementById(previewId);
  if(!el)return;
  const old=document.getElementById('__printFrame');
  if(old)old.remove();
  const iframe=document.createElement('iframe');
  iframe.id='__printFrame';
  iframe.style.cssText='position:fixed;top:-9999px;left:-9999px;width:900px;height:700px;border:none;';
  document.body.appendChild(iframe);
  const doc=iframe.contentDocument||iframe.contentWindow.document;
  doc.open();
  doc.write('<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Impressao</title><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:Arial,sans-serif;background:#fff;color:#000;padding:20px}@media print{body{margin:0;padding:0}}</style></head><body>'+el.innerHTML+'</body></html>');
  doc.close();
  setTimeout(function(){
    iframe.contentWindow.focus();
    iframe.contentWindow.print();
    setTimeout(function(){iframe.remove();},1000);
  },300);
}
</script>
<!-- Modal: Minha Conta -->
<div class="modal-ov" id="mov-minhaConta">
  <div class="modal modal-sm">
    <div class="mh"><div class="mh-icon" style="background:var(--blue-l)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div><div class="mt">Minha Conta</div><button class="btn btn-ghost btn-sm" onclick="closeMov('mov-minhaConta')">✕</button></div>
    <div class="mb-modal">
      <div class="fg"><label class="flabel">Nome completo</label><input id="mcNome" class="finput"></div>
      <div class="fg"><label class="flabel">E-mail</label><input id="mcEmail" class="finput" type="email"></div>
      <div style="border-top:1px solid var(--border);margin:16px 0;padding-top:16px">
        <div style="font-size:12.5px;font-weight:600;color:var(--text2);margin-bottom:12px">Alterar senha <span style="font-weight:400;color:var(--text3)">(deixe em branco para manter)</span></div>
        <div class="fg"><label class="flabel">Senha atual</label><input id="mcSenhaAtual" class="finput" type="password" placeholder="••••••"></div>
        <div class="fg"><label class="flabel">Nova senha</label><input id="mcNovaSenha" class="finput" type="password" placeholder="Mínimo 3 caracteres"></div>
        <div class="fg"><label class="flabel">Confirmar nova senha</label><input id="mcConfSenha" class="finput" type="password" placeholder="Repita a nova senha"></div>
      </div>
    </div>
    <div class="mf"><button class="btn btn-outline" onclick="closeMov('mov-minhaConta')">Cancelar</button><button class="btn btn-primary" onclick="salvarMinhaConta()">Salvar alterações</button></div>
  </div>
</div>


<!-- Modal: Editar Usuário -->
<div class="modal-ov" id="mov-editUser">
  <div class="modal modal-sm">
    <div class="mh"><div class="mh-icon" style="background:var(--blue-l)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div class="mt">Editar Usuário</div><button class="btn btn-ghost btn-sm" onclick="closeMov('mov-editUser')">✕</button></div>
    <div class="mb-modal">
      <input type="hidden" id="editUserId">
      <div class="fg"><label class="flabel">Nome <span class="req">*</span></label><input id="editUserNome" class="finput"></div>
      <div class="fg"><label class="flabel">E-mail <span class="req">*</span></label><input id="editUserEmail" class="finput" type="email"></div>
      <div class="fg"><label class="flabel">Perfil</label><select id="editUserPerfil" class="finput"><option value="prof_efetivo">Professor Efetivo</option><option value="prof_cnpj">Professor CNPJ</option><option value="coordenacao">Coordenação</option><option value="adm">ADM (Administrador)</option></select></div>
      <div class="fg"><label class="flabel">Nova senha <span style="color:var(--text3);font-weight:400">(deixe em branco para manter)</span></label><input id="editUserSenha" class="finput" type="password" placeholder="Nova senha..."></div>
    </div>
    <div class="mf"><button class="btn btn-outline" onclick="closeMov('mov-editUser')">Cancelar</button><button class="btn btn-primary" onclick="salvarEdicaoUsuario()">Salvar</button></div>
  </div>
</div>

<!-- Modal: Editar Aluno -->
<div class="modal-ov" id="mov-editAluno">
  <div class="modal modal-lg">
    <div class="mh"><div class="mh-icon" style="background:var(--blue-l)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div class="mt">Editar Aluno</div><button class="btn btn-ghost btn-sm" onclick="closeMov('mov-editAluno')">✕</button></div>
    <div class="mb-modal">
      <input type="hidden" id="editAlunoId">
      <div class="frow"><div class="fg"><label class="flabel">Nome <span class="req">*</span></label><input id="editANome" class="finput"></div><div class="fg"><label class="flabel">CPF <span class="req">*</span></label><input id="editACpf" class="finput" oninput="maskCpf(this)"></div></div>
      <div class="frow"><div class="fg"><label class="flabel">Código de Matrícula</label><input id="editAMatricula" class="finput"></div><div class="fg"><label class="flabel">Curso</label><select id="editACurso" class="finput"><option>ADM CRJ</option><option>Mecânico de Automóvel</option><option>Logística</option><option>Motorista Profissional</option><option>Operador de Empilhadeira</option></select></div></div>
      <div class="frow"><div class="fg"><label class="flabel">Empresa <span class="req">*</span></label><input id="editAEmpresa" class="finput"></div><div class="fg"><label class="flabel">CNPJ</label><input id="editACnpj" class="finput"></div></div>
      <div class="frow"><div class="fg"><label class="flabel">Início do contrato</label><input id="editAInicio" class="finput" type="date"></div><div class="fg"><label class="flabel">Término do contrato</label><input id="editAFim" class="finput" type="date"></div></div>
      <div class="fg"><label class="flabel">Status</label><select id="editAStatus" class="finput"><option>Em execução</option><option>Concluído</option><option>Cancelado</option><option>Desistente</option></select></div>
    </div>
    <div class="mf"><button class="btn btn-outline" onclick="closeMov('mov-editAluno')">Cancelar</button><button class="btn btn-primary" onclick="salvarEdicaoAluno()">Salvar alterações</button></div>
  </div>
</div>

<!-- Modal: Transferir Aluno de Turma -->
<div class="modal-ov" id="mov-transferirAluno">
  <div class="modal modal-sm">
    <div class="mh"><div class="mh-icon" style="background:var(--purple-l)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></div><div class="mt">Transferir de Turma</div><button class="btn btn-ghost btn-sm" onclick="closeMov('mov-transferirAluno')">✕</button></div>
    <div class="mb-modal">
      <input type="hidden" id="transAlunoId">
      <div style="background:var(--surface2);border-radius:var(--r-sm);padding:12px;margin-bottom:16px;font-size:13px">
        <div><span style="color:var(--text3)">Aluno:</span> <strong id="transAlunoNome"></strong></div>
        <div style="margin-top:4px"><span style="color:var(--text3)">Turma atual:</span> <span id="transAlunoTurmaAtual"></span></div>
      </div>
      <div class="fg"><label class="flabel">Nova turma <span class="req">*</span></label><select id="transNovaTurma" class="finput"><option value="">Selecione</option></select></div>
    </div>
    <div class="mf"><button class="btn btn-outline" onclick="closeMov('mov-transferirAluno')">Cancelar</button><button class="btn btn-primary" onclick="confirmarTransferencia()">Confirmar transferência</button></div>
  </div>
</div>

<!-- Modal: Justificar Falta -->
<div class="modal-ov" id="mov-justificarFalta">
  <div class="modal modal-sm">
    <div class="mh"><div class="mh-icon" style="background:var(--amber-l)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div><div class="mt">Justificar Falta</div><button class="btn btn-ghost btn-sm" onclick="closeMov('mov-justificarFalta')">✕</button></div>
    <div class="mb-modal">
      <input type="hidden" id="justModalAlunoId">
      <input type="hidden" id="justModalData">
      <div style="background:var(--amber-l);border-radius:var(--r-sm);padding:10px 14px;margin-bottom:16px;font-size:13px;color:var(--amber)"><strong id="justModalAlunoNome"></strong></div>
      <div class="fg"><label class="flabel">Motivo da justificativa <span class="req">*</span></label><select class="finput" id="justModalMotivo" onchange="document.getElementById('justModalTexto').placeholder=this.options[this.selectedIndex].dataset.hint||'Descreva...'">
        <option data-hint="Descreva o atestado médico...">Atestado médico</option>
        <option data-hint="Informe a declaração ou comprovante...">Declaração / comprovante</option>
        <option data-hint="Descreva a situação de força maior...">Força maior (transporte, acidente, etc.)</option>
        <option data-hint="Descreva o motivo do trabalho...">Compromisso de trabalho</option>
        <option data-hint="Descreva o motivo...">Outro</option>
      </select></div>
      <div class="fg"><label class="flabel">Descrição detalhada <span class="req">*</span></label><textarea id="justModalTexto" class="finput" placeholder="Descreva a justificativa..." rows="3"></textarea></div>
    </div>
    <div class="mf"><button class="btn btn-outline" onclick="closeMov('mov-justificarFalta')">Cancelar</button><button class="btn btn-warn" onclick="confirmarJustificativa()">Registrar justificativa</button></div>
  </div>
</div>

<!-- Modal: Advertência Manual -->
<div class="modal-ov" id="mov-advManual">
  <div class="modal modal-lg">
    <div class="mh"><div class="mh-icon" style="background:var(--amber-l)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg></div><div class="mt">Emitir Advertência Manual</div><button class="btn btn-ghost btn-sm" onclick="closeMov('mov-advManual')">✕</button></div>
    <div class="mb-modal">
      <div class="alert al-info" style="margin-bottom:16px">Use para casos que não foram gerados automaticamente por faltas (ex: comportamento, uso indevido de tecnologia).</div>
      <div class="fg"><label class="flabel">Aluno <span class="req">*</span></label><select id="advManualAluno" class="finput" onchange="atualizarInfoAdvManual()"><option value="">Selecione o aluno</option></select></div>
      <div id="advManualInfo" class="hidden" style="background:var(--surface2);border-radius:var(--r-sm);padding:10px 14px;font-size:13px;margin-bottom:12px"></div>
      <div class="fg"><label class="flabel">Motivos <span class="req">*</span></label>
        <div id="advManualMotivos" style="border:1px solid var(--border);border-radius:var(--r-sm);padding:4px 14px">
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Faltas frequentes sem justificativa"> Faltas frequentes sem justificativa</label>
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Atrasos constantes"> Atrasos constantes</label>
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Desrespeito a instrutores, funcionários ou colegas"> Desrespeito a instrutores, funcionários ou colegas</label>
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Não realização das atividades propostas"> Não realização das atividades propostas</label>
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Danos ao patrimônio da instituição"> Danos ao patrimônio da instituição</label>
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Uso inadequado de tecnologia durante as aulas"> Uso inadequado de tecnologia durante as aulas</label>
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Comportamento inadequado no ambiente escolar"> Comportamento inadequado no ambiente escolar</label>
          <label class="motivo-check"><input type="checkbox" name="advManM" value="Descumprimento das regras de conduta da instituição"> Descumprimento das regras de conduta da instituição</label>
        </div>
      </div>
      <div class="fg"><label class="flabel">Observações <span class="req">*</span></label><textarea id="advManualObs" class="finput" placeholder="Descreva a ocorrência que gerou a advertência..."></textarea></div>
    </div>
    <div class="mf"><button class="btn btn-outline" onclick="closeMov('mov-advManual')">Cancelar</button><button class="btn btn-warn" onclick="confirmarAdvManual()">Emitir advertência</button></div>
  </div>
</div>

</body>
</html>
